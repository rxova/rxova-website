{
  "$schema": "https://v2-10-7.turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".nvmrc"],
  "tasks": {
    // The sites build. @rxova/brand ships uncompiled source and has no `build` script;
    // `^build` is declared anyway in case it gains one.
    "build": {
      "dependsOn": ["^build"],
      // Declared because Turbo's strict env would otherwise hide it from astro, and it
      // must be in the hash so builds for different base URLs don't replay each other.
      "env": ["DOCS_BASE_URL"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    // Hashes the files outside the landing's directory that it reads: sources.json and
    // brand/astro-ui source and social cards, consumed unbuilt.
    "@rxova/landing#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/sources.json",
        "$TURBO_ROOT$/packages/brand/src/**",
        "$TURBO_ROOT$/packages/brand/assets/**",
        "$TURBO_ROOT$/packages/astro-ui/src/**",
        "$TURBO_ROOT$/packages/tooling/src/deploy/sync-brand-og.ts"
      ],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "@rxova/landing#check:astro": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/sources.json",
        "$TURBO_ROOT$/packages/brand/src/**",
        "$TURBO_ROOT$/packages/astro-ui/src/**"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    // Both read dist/, so they wait on this package's own build, not only its
    // dependencies', or they could check a stale or absent tarball.
    "check:exports": {
      "dependsOn": ["build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "pack:smoke": {
      "dependsOn": ["build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    // The tooling's tests read the real registry, redirect map and CI workflow at the repo root, and import
    // @rxova/website-schemas from its dist/.
    "@rxova/repo-tooling#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/sources.json",
        "$TURBO_ROOT$/redirects.json",
        "$TURBO_ROOT$/.github/workflows/ci.yml"
      ],
      "outputLogs": "new-only"
    },
    // `^test` keeps the cache honest: dependents test against dependencies' uncompiled source.
    // Inputs are only what a run reads (source, config, manifest, and prose for the content packages).
    "test": {
      "dependsOn": ["^test"],
      "inputs": [
        "src/**",
        "scripts/**",
        "test/**",
        "posts/**",
        "updates/**",
        "authors/**",
        "vitest.config.ts",
        "package.json"
      ],
      "outputs": ["coverage/**"],
      "outputLogs": "new-only"
    },
    // The landing's suite reads the repo-root sources.json through src/lib/projects.ts.
    "@rxova/landing#test": {
      "dependsOn": ["^test"],
      "inputs": ["src/**", "vitest.config.ts", "package.json", "$TURBO_ROOT$/sources.json"],
      "outputs": ["coverage/**"],
      "outputLogs": "new-only"
    },
    // test/render.test.ts runs a real `astro build`, which needs dependencies' dist/ (`^build`) and
    // must run after `check:astro` so two astro processes never share `node_modules/.astro`.
    "@rxova/blog#test": {
      "dependsOn": ["^test", "^build", "check:astro"],
      "inputs": [
        "src/**",
        "test/**",
        "posts/**",
        "authors/**",
        "astro.config.mjs",
        "vitest.config.ts",
        "package.json"
      ],
      "outputs": ["coverage/**"],
      "outputLogs": "new-only"
    },
    // Ordered after this package's own `build` (not a data dependency): two concurrent astro
    // runs in one package race on `node_modules/.astro/data-store.json` and fail.
    "check:astro": {
      "dependsOn": ["^build", "build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    // Keyed on exactly what the card fingerprint hashes (see packages/brand/scripts/generate-og.ts),
    // so component, style or doc edits replay this instead of re-running satori.
    "check:og": {
      "outputs": [],
      "inputs": [
        "src/tokens.css",
        "src/sites.ts",
        "scripts/generate-og.ts",
        "scripts/og-manifest.json",
        "assets/og/**"
      ],
      "outputLogs": "new-only"
    },
    // Renders and rewrites the committed PNGs, so it must never be replayed
    // from cache — the whole point is the side effect on assets/og/.
    "og": {
      "cache": false
    },
    // Root task keyed on the dependency manifests, so source edits replay it. Not applied to
    // audit:check, whose verdict changes with the upstream advisory database.
    "//#dedupe:check": {
      "outputs": [],
      "inputs": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "package.json",
        "packages/*/package.json",
        "apps/*/package.json"
      ],
      "outputLogs": "new-only"
    },
    // Root task: validates both surfaces in one pass, keyed on exactly the prose, schema,
    // REPOS registry and script it reads.
    "//#validate:content": {
      "dependsOn": ["@rxova/website-schemas#build"],
      "outputs": [],
      "inputs": [
        "apps/blog/posts/**",
        "apps/blog/authors/**",
        "apps/updates/updates/**",
        "apps/updates/authors/**",
        "packages/website-schemas/src/**",
        "packages/brand/src/sites.ts",
        "packages/tooling/src/repo/validate-content.ts"
      ],
      "outputLogs": "new-only"
    },
    // Each app's specs run against its own build.
    "e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    // The assembled site rebuilds the blog and updates for their mounts, in the same dist/ the
    // per-app previews serve, so it runs after them.
    "@rxova/e2e#e2e": {
      "dependsOn": ["@rxova/landing#e2e", "@rxova/blog#e2e", "@rxova/updates#e2e"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
