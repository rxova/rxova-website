{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Renovate replaces Dependabot here, and with it the Dependabot config and
  // the auto-merge workflow that armed its pull requests. Same bot as the
  // other rxova repositories, so every repository updates the same way.

  extends: [
    'config:recommended',

    // One pull request for everything that is not a major, which is what the
    // Dependabot `groups` blocks were doing. The GitHub Actions pinned in
    // .github/workflows and .github/actions are covered by Renovate without a
    // separate entry, and land in the same pull request.
    'group:allNonMajor',
    'schedule:weekly',

    // Hold a freshly published version back for a few days. A compromised
    // release is usually caught within hours, and nothing here is urgent
    // enough to be the one that finds out first.
    'security:minimumReleaseAgeNpm',

    // `chore(deps): …`, so the pull request title — the squash subject — is a
    // valid commit subject for commitlint.
    ':semanticCommits',
    ':semanticCommitTypeAll(chore)',

    // A major waits on the Dependency Dashboard until it is ticked, rather
    // than opening a pull request nobody asked for. Replaces the major-bump
    // guard that lived in the auto-merge workflow.
    ':approveMajorUpdates',

    // Refreshes the whole lockfile monthly. Transitive versions only move when
    // something above them does, so without this a lockfile quietly keeps
    // stale copies that the registry has long since patched.
    ':maintainLockFilesMonthly',
  ],

  // The label Dependabot applied by default. It already exists here.
  labels: ['dependencies'],

  // Move the declared range rather than only the lockfile, so `package.json`
  // says what is actually installed.
  rangeStrategy: 'bump',

  packageRules: [
    {
      // Patch and minor merge themselves once CI is green. `platformAutomerge`
      // hands that to GitHub's own auto-merge, so it waits for the required
      // `all checks` status exactly as the old workflow did — but without a
      // workflow, and without the token dance a bot-authored push needs.
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
      platformAutomerge: true,
    },
    {
      // TypeScript 7 is held, not skipped: the native rewrite breaks
      // typescript-eslint, which is the whole `lint` step. Written as a
      // ceiling rather than an ignore so 6.x patches and minors still come
      // through.
      //
      // Lift it by deleting this rule once typescript-eslint accepts TS 7.
      matchPackageNames: ['typescript'],
      allowedVersions: '<7',
    },
  ],
}
