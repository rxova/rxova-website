@@ -1,8 +1,10 @@
 export type Line = { sku: string; qty: number; unitCents: number }
 
+const CODES: Record<string, number> = { SPRING10: 0.1, WELCOME5: 0.05 }
+
 export function invoiceTotal(lines: Line[], taxRate: number, code?: string) {
   const subtotal = lines.reduce((sum, l) => sum + l.qty * l.unitCents, 0)
-  const discount = code === 'SPRING10' ? Math.round(subtotal * 0.1) : 0
-  const tax = Math.round((subtotal - discount) * taxRate)
+  const tax = Math.round(subtotal * taxRate)
+  const discount = code ? Math.round((subtotal + tax) * (CODES[code] ?? 0)) : 0
   return { subtotal, discount, tax, total: subtotal - discount + tax }
 }
