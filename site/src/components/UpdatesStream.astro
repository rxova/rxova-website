---
/**
 * The updates stream: every entry rendered in full, newest first.
 *
 * Entries are short, so a timeline reads better as one page than as a list of
 * links to one-paragraph pages. Each carries a stable `#slug` anchor, which is the
 * permalink until an entry is ever long enough to deserve its own route.
 *
 * ## Filtering, and why the two facets differ
 *
 * Repo chips are **real links** to `/updates/repos/<id>`, which is pre-rendered.
 * The script below intercepts clicks and filters in place instead, so with JS you
 * get combinable filters and a shareable querystring, and without it you still get
 * a working, crawlable, single-repo page. Tag chips have no such page — the tag
 * vocabulary is longer and not worth a route each — so they are buttons, hidden
 * until the script un-hides them.
 *
 * Filtering is show/hide over markup that is already in the DOM. No fetching, no
 * re-render. Worth revisiting past roughly 200 entries; not before.
 */
import type { UpdateEntry } from '../lib/content'
import { repoLabel, formatDate, isoDate, byline } from '../lib/content'

export interface StreamItem {
  entry: UpdateEntry
  Body: import('astro/runtime/server/index.js').AstroComponentFactory
  authorNames: string[]
}

interface Props {
  items: StreamItem[]
  /** Repo ids offered as filters. Empty hides the repo row (e.g. on a repo page). */
  repos?: { id: string; label: string }[]
  tags?: string[]
  /** Pre-applied repo, on `/updates/repos/<id>`. Disables the filter UI. */
  activeRepo?: string
}

const { items, repos = [], tags = [], activeRepo } = Astro.props
const filterable = !activeRepo && (repos.length > 0 || tags.length > 0)
---

{
  filterable && (
    <div class="filters" data-filters>
      <div class="row">
        <span class="row-label" id="filter-repos">
          Repo
        </span>
        <div class="chips" role="group" aria-labelledby="filter-repos">
          {repos.map((r) => (
            <a class="chip" href={`/updates/repos/${r.id}`} data-repo={r.id} aria-pressed="false">
              {r.label}
            </a>
          ))}
        </div>
      </div>

      {/* Hidden until the script runs: without JS these do nothing, and a dead
          control is worse than an absent one. */}
      <div class="row" data-tag-row hidden>
        <span class="row-label" id="filter-tags">
          Tag
        </span>
        <div class="chips" role="group" aria-labelledby="filter-tags">
          {tags.map((t) => (
            <button class="chip" type="button" data-tag={t} aria-pressed="false">
              {t}
            </button>
          ))}
        </div>
      </div>

      <p class="count" data-count aria-live="polite" />
      <button class="clear" type="button" data-clear hidden>
        Clear filters
      </button>
    </div>
  )
}

<ol class="stream" data-stream>
  {
    items.map(({ entry, Body, authorNames }) => (
      <li
        class="entry"
        id={entry.id}
        data-repos={entry.data.repos.join(' ')}
        data-tags={entry.data.tags.join(' ')}
      >
        <div class="when">
          <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
        </div>
        <div class="what">
          <h2>
            <a href={`#${entry.id}`} class="anchor">
              {entry.data.title}
            </a>
          </h2>
          <p class="meta">
            {entry.data.repos.map((r) => (
              <a class="repo" href={`/updates/repos/${r}`}>
                {repoLabel(r)}
              </a>
            ))}
            {entry.data.tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
            {entry.data.version && <span class="version">{entry.data.version}</span>}
          </p>
          <div class="prose">
            <Body />
          </div>
          {entry.data.links.length > 0 && (
            <nav class="links" aria-label={`${entry.data.title} links`}>
              {entry.data.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener noreferrer">
                  {l.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </nav>
          )}
          <p class="by">{byline(authorNames)}</p>
        </div>
      </li>
    ))
  }
</ol>

<p class="none" data-none hidden>No entries match those filters.</p>

<style>
  .filters {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .row-label {
    color: var(--faint);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    min-width: 3.5rem;
  }
  .chips {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .chip {
    font: inherit;
    font-size: 0.85rem;
    color: var(--muted);
    background: var(--tag-bg);
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.15rem 0.65rem;
    cursor: pointer;
    text-decoration: none;
  }
  .chip:hover {
    color: var(--fg);
    border-color: var(--rule);
  }
  .chip[aria-pressed='true'] {
    color: var(--fg);
    border-color: var(--accent);
  }
  .chip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .count {
    color: var(--faint);
    font-size: 0.85rem;
  }
  .clear {
    justify-self: start;
    font: inherit;
    font-size: 0.85rem;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .clear:hover {
    color: var(--fg);
  }

  .stream {
    list-style: none;
    display: grid;
    gap: 2.5rem;
  }
  .entry {
    display: grid;
    gap: 0.35rem 2rem;
    /* Date beside the entry on wide screens, above it on narrow. */
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 46rem) {
    .entry {
      grid-template-columns: 9rem minmax(0, 1fr);
    }
  }
  .when time {
    color: var(--faint);
    font-size: 0.85rem;
    font-family: var(--mono);
  }
  .what h2 {
    font-size: 1.1rem;
    font-weight: 640;
    letter-spacing: -0.01em;
  }
  .anchor {
    color: var(--fg);
    text-decoration: none;
  }
  .anchor:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .meta {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin: 0.4rem 0 0.75rem;
    font-size: 0.78rem;
  }
  .repo,
  .tag,
  .version {
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    background: var(--tag-bg);
    color: var(--muted);
  }
  .repo {
    text-decoration: none;
    border: 1px solid var(--rule);
  }
  .repo:hover {
    color: var(--fg);
  }
  .version {
    font-family: var(--mono);
    background: none;
    color: var(--faint);
    padding-left: 0;
  }
  .links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.9rem;
    font-size: 0.9rem;
  }
  .links a {
    color: var(--muted);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--fg);
  }
  .by {
    margin-top: 0.9rem;
    color: var(--faint);
    font-size: 0.82rem;
  }
  .none {
    color: var(--faint);
  }
  .entry[hidden] {
    display: none;
  }
</style>

<script>
  ;(function () {
    const root = document.querySelector<HTMLElement>('[data-filters]')
    const stream = document.querySelector<HTMLElement>('[data-stream]')
    if (!root || !stream) return

    const entries = Array.from(stream.querySelectorAll<HTMLElement>('.entry'))
    const repoChips = Array.from(root.querySelectorAll<HTMLElement>('[data-repo]'))
    const tagChips = Array.from(root.querySelectorAll<HTMLElement>('[data-tag]'))
    const tagRow = root.querySelector<HTMLElement>('[data-tag-row]')
    const count = root.querySelector<HTMLElement>('[data-count]')
    const clear = root.querySelector<HTMLElement>('[data-clear]')
    const none = document.querySelector<HTMLElement>('[data-none]')

    // Tag filtering only exists with JS, so the row stays hidden until now.
    if (tagRow) tagRow.hidden = false

    const active = { repo: new Set<string>(), tag: new Set<string>() }

    function readUrl() {
      const params = new URLSearchParams(location.search)
      active.repo = new Set((params.get('repo') ?? '').split(',').filter(Boolean))
      active.tag = new Set((params.get('tag') ?? '').split(',').filter(Boolean))
    }

    function writeUrl(push: boolean) {
      const params = new URLSearchParams()
      if (active.repo.size) params.set('repo', [...active.repo].join(','))
      if (active.tag.size) params.set('tag', [...active.tag].join(','))
      const qs = params.toString()
      const url = qs ? `${location.pathname}?${qs}` : location.pathname
      // Replace rather than push while the user is toggling chips, so Back leaves
      // the updates page instead of walking every filter combination they tried.
      if (push) history.pushState(null, '', url)
      else history.replaceState(null, '', url)
    }

    function matches(el: HTMLElement) {
      const repos = (el.dataset.repos ?? '').split(' ').filter(Boolean)
      const tags = (el.dataset.tags ?? '').split(' ').filter(Boolean)
      // Within a facet: OR. Across facets: AND. "journey or brand, and tagged fix."
      const repoOk = active.repo.size === 0 || repos.some((r) => active.repo.has(r))
      const tagOk = active.tag.size === 0 || tags.some((t) => active.tag.has(t))
      return repoOk && tagOk
    }

    function apply() {
      let shown = 0
      for (const el of entries) {
        const ok = matches(el)
        el.hidden = !ok
        if (ok) shown++
      }
      for (const chip of repoChips) {
        chip.setAttribute('aria-pressed', String(active.repo.has(chip.dataset.repo!)))
      }
      for (const chip of tagChips) {
        chip.setAttribute('aria-pressed', String(active.tag.has(chip.dataset.tag!)))
      }

      const filtered = active.repo.size > 0 || active.tag.size > 0
      if (clear) clear.hidden = !filtered
      if (none) none.hidden = shown > 0
      // Announced: a filter that silently removes two thirds of the page is
      // invisible to a screen reader otherwise.
      if (count) {
        count.textContent = filtered
          ? `${shown} of ${entries.length} ${entries.length === 1 ? 'entry' : 'entries'}`
          : ''
      }
    }

    function toggle(set: Set<string>, value: string) {
      if (set.has(value)) set.delete(value)
      else set.add(value)
      writeUrl(false)
      apply()
    }

    for (const chip of repoChips) {
      chip.addEventListener('click', (e) => {
        // The href goes to the pre-rendered single-repo page, which is what a
        // crawler and a no-JS visitor get. With JS, filter in place instead so
        // repos and tags can combine.
        e.preventDefault()
        toggle(active.repo, chip.dataset.repo!)
      })
    }
    for (const chip of tagChips) {
      chip.addEventListener('click', () => toggle(active.tag, chip.dataset.tag!))
    }
    clear?.addEventListener('click', () => {
      active.repo.clear()
      active.tag.clear()
      writeUrl(true)
      apply()
    })
    // Deep links and Back/Forward both land here.
    window.addEventListener('popstate', () => {
      readUrl()
      apply()
    })

    readUrl()
    apply()
  })()
</script>
