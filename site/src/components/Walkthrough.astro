---
/**
 * A project's centrepiece: one job done by hand, then with the project, told as
 * a short guided tour. Each note is a step — a problem on the Before side, its
 * fix on the After side — and the tour shows one at a time: its caption under
 * the bar, and only its lines highlighted, scrolled into view inside the code.
 *
 * Ported from ts-extended-errors' docs landing page, where it started, and
 * generalised: the story is data (see ../lib/walkthrough.ts and
 * ../showcases/<id>/), so every project tells its own in the same frame.
 *
 * Why a tour rather than every note at once: the code is taller than a screen,
 * so a list of notes above it left the reader matching note 3 to lines they
 * could not see. With one note showing and the code scrolled to its lines, the
 * two are always on screen together. The code scrolls inside its own box, never
 * the page.
 *
 * Progressive. Without JavaScript both sides show in full, one above the other,
 * with every note listed. The script turns that into the tour; it plays by
 * itself only when the reader has not asked for reduced motion, and the
 * arrows step through it either way. On the landing several of these share a
 * page, one per project panel, so a tour only plays while its panel is the one
 * showing and it is on screen; switching projects pauses it where it was.
 */
import { Code } from 'astro-expressive-code/components'
import { lineMarkers, type Showcase } from '../lib/walkthrough'

interface Props {
  story: Showcase
  /** Prefixes the ids inside, which must be unique on a page with several. */
  id: string
}

const { story, id } = Astro.props

// Inline code in a note, without pulling a markdown renderer into a component.
const code = (text: string) =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/`([^`]+)`/g, '<code>$1</code>')

const sides = (['before', 'after'] as const).map((key) => {
  const side = story[key]
  const text = side.code.trimEnd()
  return {
    key,
    label: side.label,
    lang: side.lang,
    code: text,
    notes: story.notes.map((note) => (key === 'before' ? note.problem : note.fix)),
    markers: { [key === 'before' ? 'del' : 'ins']: lineMarkers(text, story.notes, key) },
  }
})

const icons = {
  prev: '<path d="M10 3.5 5.5 8l4.5 4.5" />',
  next: '<path d="M6 3.5 10.5 8 6 12.5" />',
}
---

<section class="walkthrough" aria-labelledby={`${id}-heading`} data-walkthrough>
  <h4 class="heading" id={`${id}-heading`}>
    {story.heading}
  </h4>
  <p class="lede">{story.lede}</p>

  <div class="window">
    <div class="bar" hidden data-bar>
      <div class="tabs" role="group" aria-label="Show">
        {sides.map((side) => (
          <button
            type="button"
            class="tab"
            data-show={side.key}
            aria-pressed={side.key === 'before' ? 'true' : 'false'}
          >
            <span class={`dot ${side.key}`} aria-hidden="true" />
            {/* The full label where the window has room for it; "Before" and
                "After" where it does not — "With ts-extended-errors" is wider
                than half a phone. See the container query below. */}
            <span class="tab-long">{side.label}</span>
            <span class="tab-short">{side.key === 'before' ? 'Before' : 'After'}</span>
          </button>
        ))}
      </div>

      <div class="controls">
        <button type="button" class="icon-button" data-prev aria-label="Previous note">
          <svg viewBox="0 0 16 16" aria-hidden="true" set:html={icons.prev} />
        </button>
        <span class="count" data-count aria-live="polite"></span>
        <button type="button" class="icon-button" data-next aria-label="Next note">
          <svg viewBox="0 0 16 16" aria-hidden="true" set:html={icons.next} />
        </button>
        <button type="button" class="icon-button play" data-play data-state="paused">
          <svg class="icon pause" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5.25 3.5v9M10.75 3.5v9"></path>
          </svg>
          <svg class="icon resume" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5 3.2v9.6L12.6 8z"></path>
          </svg>
          <svg class="icon replay" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3.2 8a4.8 4.8 0 1 0 1.4-3.4M4.2 2.4v2.8H7"></path>
          </svg>
          <span class="sr-only" data-play-label>
            Play the walkthrough
          </span>
        </button>
      </div>

      {/* The progress, as the bar's bottom edge. A native range underneath, so
          dragging, clicking, arrow keys and screen readers all work without
          code of ours; the line and the fill are drawn over it. */}
      <div class="progress" data-progress>
        <input
          type="range"
          min="0"
          max="1"
          step="50"
          value="0"
          aria-label="Walkthrough progress"
          data-scrubber
        />
      </div>
    </div>

    <p class="caption" hidden data-caption>
      <span class="caption-number" data-caption-number></span>
      <span class="caption-text" data-caption-text></span>
    </p>

    <div class="panes">
      {sides.map((side) => (
        <div
          class={`pane ${side.key}`}
          role="group"
          data-pane={side.key}
          aria-labelledby={`${id}-${side.key}-label`}
        >
          <p class="label" id={`${id}-${side.key}-label`}>
            <span class={`dot ${side.key}`} aria-hidden="true" />
            {side.label}
          </p>
          <ol class="notes">
            {side.notes.map((note) => (
              <li class="note" data-note>
                <span set:html={code(note)} />
              </li>
            ))}
          </ol>
          <div class="code" data-code>
            <Code code={side.code} lang={side.lang} {...side.markers} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // How long each note stays up: long enough to read it and find its lines.
  // The first fix gets a little longer, for the turn from Before to After.
  const NOTE_MS = 3600
  const TURN_MS = 1200

  for (const root of document.querySelectorAll<HTMLElement>('[data-walkthrough]')) {
    // Once per element: in development a hot reload can run this module again
    // over the same page, and two tours driving one set of controls is how
    // Pause ends up stopping one of them while the other carries on.
    if (root.dataset.js !== undefined) continue

    const q = <T extends Element>(selector: string) => root.querySelector<T>(selector)
    const bar = q<HTMLElement>('[data-bar]')
    const caption = q<HTMLElement>('[data-caption]')
    const captionNumber = q<HTMLElement>('[data-caption-number]')
    const captionText = q<HTMLElement>('[data-caption-text]')
    const count = q<HTMLElement>('[data-count]')
    const prev = q<HTMLButtonElement>('[data-prev]')
    const next = q<HTMLButtonElement>('[data-next]')
    const play = q<HTMLButtonElement>('[data-play]')
    const playLabel = q<HTMLElement>('[data-play-label]')
    const progress = q<HTMLElement>('[data-progress]')
    const scrubber = q<HTMLInputElement>('[data-scrubber]')
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-show]')]
    const panes = [...root.querySelectorAll<HTMLElement>('[data-pane]')]
    if (
      !bar ||
      !caption ||
      !captionNumber ||
      !captionText ||
      !count ||
      !prev ||
      !next ||
      !play ||
      !playLabel ||
      !progress ||
      !scrubber
    ) {
      continue
    }

    // One step per note per side, in order: every problem, then every fix.
    // Expressive Code writes a marker's label into its line's inline
    // `--tmLabel`, which is how each note finds the lines it points at.
    type Step = {
      side: string
      index: number
      html: string
      lines: HTMLElement[]
      box: HTMLElement
    }
    const steps: Step[] = panes.flatMap((pane) => {
      const box = pane.querySelector<HTMLElement>('[data-code]')
      if (!box) return []
      const lines = [...pane.querySelectorAll<HTMLElement>('.ec-line')]
      const labelOf = (line: HTMLElement) =>
        line.style.getPropertyValue('--tmLabel').replace(/\D/g, '')
      return [...pane.querySelectorAll<HTMLElement>('[data-note]')].map((note, index) => {
        const part = lines.filter((line) => labelOf(line) === String(index + 1))
        for (const line of part) line.classList.add('part')
        return { side: pane.dataset.pane ?? '', index, html: note.innerHTML, lines: part, box }
      })
    })
    const total = steps.filter((step) => step.side === 'before').length
    if (steps.length === 0) continue

    // The tour as a timeline: every step starts at a time, and the view is a
    // function of one clock, so the progress line can jump anywhere and the
    // view is simply drawn again for that moment.
    const starts: number[] = []
    let clock = 0
    for (const [index, step] of steps.entries()) {
      starts.push(clock)
      const turning = step.side === 'after' && steps[index - 1]?.side === 'before'
      clock += NOTE_MS + (turning ? TURN_MS : 0)
    }
    const end = clock
    scrubber.max = String(end)

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
    type State = 'playing' | 'paused' | 'ended'
    const labels: Record<State, string> = {
      playing: 'Pause the walkthrough',
      paused: 'Play the walkthrough',
      ended: 'Replay the walkthrough',
    }
    let state: State = 'paused'
    let time = 0
    let frame: number | undefined
    let last = 0
    let current = -1
    let started = false
    let pausedByPage = false

    const stepAt = (t: number) => {
      let index = 0
      for (const [i, start] of starts.entries()) if (start <= t) index = i
      return index
    }

    // Brings a step's first line near the top of its code box, with a few lines
    // of context above it — the box scrolls, the page does not.
    const reveal = (step: Step) => {
      const [first] = step.lines
      if (!first) return
      const top = first.offsetTop - step.box.clientHeight / 5
      step.box.scrollTo({ top: Math.max(0, top), behavior: reduced ? 'auto' : 'smooth' })
    }

    const apply = (index: number) => {
      const step = steps[index]
      if (!step || index === current) return
      current = index
      root.dataset.show = step.side
      for (const tab of tabs) {
        tab.setAttribute('aria-pressed', String(tab.dataset.show === step.side))
      }
      for (const pane of panes) pane.inert = pane.dataset.pane !== step.side
      for (const [i, other] of steps.entries()) {
        for (const line of other.lines) line.classList.toggle('lit', i === index)
      }
      const kind = step.side === 'before' ? 'Problem' : 'Fix'
      caption.dataset.side = step.side
      captionNumber.textContent = String(step.index + 1)
      captionText.innerHTML = step.html
      count.textContent = `${kind} ${String(step.index + 1)} of ${String(total)}`
      prev.disabled = index === 0
      next.disabled = index === steps.length - 1
      // Retriggers the caption's fade: the new text arrives, not replaces.
      caption.classList.remove('enter')
      void caption.offsetWidth
      caption.classList.add('enter')
      reveal(step)
    }

    const draw = () => {
      apply(stepAt(time))
      scrubber.value = String(time)
      progress.style.setProperty('--progress', `${String((time / end) * 100)}%`)
      scrubber.setAttribute('aria-valuetext', count.textContent ?? '')
    }

    const setState = (nextState: State) => {
      state = nextState
      play.dataset.state = nextState
      playLabel.textContent = labels[nextState]
    }

    const stop = () => {
      if (frame !== undefined) cancelAnimationFrame(frame)
      frame = undefined
    }

    const tick = (now: number) => {
      time = Math.min(end, time + (now - last))
      last = now
      draw()
      if (time >= end) {
        stop()
        setState('ended')
        return
      }
      frame = requestAnimationFrame(tick)
    }

    const resume = () => {
      if (time >= end) time = 0
      setState('playing')
      last = performance.now()
      stop()
      frame = requestAnimationFrame(tick)
    }

    const pause = () => {
      stop()
      if (state === 'playing') setState('paused')
    }

    // Taking over — a step, a tab, a drag — stops the tour where the reader
    // put it, rather than moving the view away from them again.
    const goTo = (index: number) => {
      pause()
      const target = Math.max(0, Math.min(steps.length - 1, index))
      time = starts[target] ?? 0
      draw()
      if (target === steps.length - 1) setState('ended')
    }

    // The JS layout: the bar and the caption come in, the no-JS note lists go.
    root.dataset.js = ''
    bar.hidden = false
    caption.hidden = false
    setState('paused')
    draw()

    play.addEventListener('click', () => {
      if (state === 'playing') pause()
      else resume()
    })
    prev.addEventListener('click', () => {
      goTo(current - 1)
    })
    next.addEventListener('click', () => {
      goTo(current + 1)
    })
    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        goTo(steps.findIndex((step) => step.side === tab.dataset.show))
      })
    }
    scrubber.addEventListener('input', () => {
      pause()
      time = Number(scrubber.value)
      draw()
      setState(time >= end ? 'ended' : 'paused')
    })

    // Reading the code by hand is taking over too.
    for (const step of steps) {
      for (const type of ['wheel', 'touchstart'] as const) {
        step.box.addEventListener(type, pause, { passive: true })
      }
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden && state === 'playing') {
        pausedByPage = true
        pause()
      } else if (!document.hidden && pausedByPage) {
        pausedByPage = false
        resume()
      }
    })

    // On the landing each tour sits in a project panel, and only one panel
    // shows at a time. Hidden panels still take up layout — they share the
    // stage's grid cell — so an IntersectionObserver alone would start every
    // project's tour at once. It plays only when both hold: its panel is the
    // active one, and it has scrolled into view.
    const panel = root.closest<HTMLElement>('.panel')
    const panelShowing = () => !panel || panel.classList.contains('is-active')
    let inView = false

    const update = () => {
      if (!panelShowing()) {
        pause()
        return
      }
      if (inView && !started && !reduced) {
        started = true
        resume()
      }
    }

    new IntersectionObserver(
      (entries) => {
        inView = entries.some((entry) => entry.isIntersecting)
        update()
      },
      // Most of the window has to be on screen before it starts, so the first
      // note is not spent while the reader is still scrolling towards it.
      { threshold: 0.6 },
    ).observe(root)

    if (panel) {
      new MutationObserver(update).observe(panel, {
        attributes: true,
        attributeFilter: ['class'],
      })
    }
  }
</script>

<style>
  /* Before and after, as the docs sites colour them (Starlight's red and green
     pairs): the dots, the caption's number, and nothing else. */
  .walkthrough {
    --wt-before: hsl(339 80% 42%);
    --wt-before-soft: hsl(339 88% 94%);
    --wt-after: hsl(139 70% 28%);
    --wt-after-soft: hsl(139 60% 92%);
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .walkthrough {
      --wt-before: hsl(339 100% 80%);
      --wt-before-soft: hsl(339 39% 20%);
      --wt-after: hsl(139 70% 72%);
      --wt-after-soft: hsl(139 38% 18%);
    }
  }

  :global(html[data-theme='dark']) .walkthrough {
    --wt-before: hsl(339 100% 80%);
    --wt-before-soft: hsl(339 39% 20%);
    --wt-after: hsl(139 70% 72%);
    --wt-after-soft: hsl(139 38% 18%);
  }

  .walkthrough {
    width: 100%;
    margin-top: 0.75rem;
  }

  .heading {
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    font-weight: 620;
    letter-spacing: -0.015em;
    line-height: 1.25;
    text-wrap: balance;
  }

  .lede {
    max-width: 42rem;
    margin: 0.4rem 0 1rem;
    color: var(--rx-muted);
    font-size: 0.95rem;
    text-wrap: pretty;
  }

  /* One frame. The code sits straight in it: no inner box, no second border.
     A size container, so the bar lays itself out for the window's width, not
     the viewport's. */
  .window {
    container-type: inline-size;
    overflow: clip;
    border: 1px solid var(--rx-rule-strong);
    border-radius: var(--rx-radius);
    background: var(--rx-bg);
    transition: border-color 0.3s ease;
  }

  /* The brand gradient's one placement in the panel: the side worth copying. */
  .walkthrough[data-show='after'] .window {
    border-color: transparent;
    background:
      linear-gradient(var(--rx-bg), var(--rx-bg)) padding-box,
      var(--rx-gradient) border-box;
  }

  /* --- The bar ------------------------------------------------------- */
  .bar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.5rem 0.6rem 0.6rem;
  }

  .bar[hidden],
  .caption[hidden] {
    display: none;
  }

  /* A segmented switch: the two sides are one choice, not two buttons. */
  .tabs {
    display: inline-flex;
    padding: 3px;
    border-radius: var(--rx-radius-pill);
    background: var(--rx-card);
    box-shadow: inset 0 0 0 1px var(--rx-rule);
  }

  button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }

  button:focus-visible {
    outline: 2px solid var(--rx-fg);
    outline-offset: 2px;
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.1rem;
    padding: 0 0.85rem;
    border-radius: var(--rx-radius-pill);
    color: var(--rx-muted);
    font-size: 0.85rem;
    font-weight: 550;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .tab:hover {
    color: var(--rx-fg);
  }

  .tab[aria-pressed='true'] {
    background: var(--rx-bg);
    color: var(--rx-fg);
    box-shadow:
      0 0 0 1px var(--rx-rule-strong),
      0 1px 2px color-mix(in srgb, var(--rx-fg) 8%, transparent);
  }

  .tab-short {
    display: none;
  }

  .dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .dot.before {
    background: var(--wt-before);
  }

  .dot.after {
    background: var(--wt-after);
  }

  .controls {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    margin-left: auto;
  }

  .count {
    min-width: 7.5em;
    text-align: center;
    color: var(--rx-muted);
    font-family: var(--rx-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .icon-button {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    color: var(--rx-muted);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .icon-button:hover:not(:disabled) {
    background: var(--rx-card);
    color: var(--rx-fg);
  }

  .icon-button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .icon-button svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .play {
    margin-left: 0.25rem;
    box-shadow: inset 0 0 0 1px var(--rx-rule-strong);
  }

  .play .resume {
    fill: currentColor;
    stroke: none;
  }

  .play .icon {
    display: none;
  }

  .play[data-state='playing'] .pause,
  .play[data-state='paused'] .resume,
  .play[data-state='ended'] .replay {
    display: block;
  }

  /* The progress: the bar's bottom edge, filled in brand violet. The range
     input spans a taller, invisible strip over it so it is easy to grab. */
  .progress {
    --progress: 0%;
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--rx-rule);
  }

  .progress::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--progress);
    background: var(--rx-primary);
    pointer-events: none;
  }

  .progress input {
    position: absolute;
    inset: -7px 0;
    z-index: 1;
    width: 100%;
    height: 16px;
    margin: 0;
    background: transparent;
    cursor: pointer;
    appearance: none;
  }

  .progress input::-webkit-slider-runnable-track {
    height: 100%;
    background: transparent;
  }

  .progress input::-moz-range-track {
    background: transparent;
  }

  /* No thumb until the line is being handled. */
  .progress input::-webkit-slider-thumb {
    width: 10px;
    height: 10px;
    margin-top: 3px;
    border-radius: 50%;
    background: var(--rx-primary);
    opacity: 0;
    appearance: none;
    transition: opacity 0.15s ease;
  }

  .progress input::-moz-range-thumb {
    width: 10px;
    height: 10px;
    border: 0;
    border-radius: 50%;
    background: var(--rx-primary);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .progress input:hover::-webkit-slider-thumb,
  .progress input:focus-visible::-webkit-slider-thumb {
    opacity: 1;
  }

  .progress input:hover::-moz-range-thumb,
  .progress input:focus-visible::-moz-range-thumb {
    opacity: 1;
  }

  .progress input:focus-visible {
    outline: none;
  }

  .progress:has(input:focus-visible) {
    outline: 2px solid var(--rx-fg);
    outline-offset: 4px;
  }

  /* --- The caption: the one note in play --------------------------- */
  .caption {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    align-items: start;
    gap: 0.7rem;
    min-height: 4.4rem;
    margin: 0;
    padding: 0.9rem 1.1rem;
    border-bottom: 1px solid var(--rx-rule);
    color: var(--rx-fg);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .caption-number {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 650;
  }

  .caption[data-side='before'] .caption-number {
    background: var(--wt-before-soft);
    color: var(--wt-before);
  }

  .caption[data-side='after'] .caption-number {
    background: var(--wt-after-soft);
    color: var(--wt-after);
  }

  .caption :global(code),
  .note :global(code) {
    font-family: var(--rx-font-mono);
    font-size: 0.88em;
    padding: 0.05em 0.3em;
    border-radius: 4px;
    background: var(--rx-card);
  }

  /* --- The code ------------------------------------------------------ */
  .panes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding: 1rem;
  }

  .pane + .pane {
    border-top: 1px solid var(--rx-rule);
  }

  .label {
