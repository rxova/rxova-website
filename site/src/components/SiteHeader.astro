---
/**
 * The site menu, on every surface this repo renders.
 *
 * The landing used to carry two small text links under its lede, which read as
 * afterthoughts rather than navigation — and meant the landing and the content
 * pages had different chrome. One component instead, so adding a fourth surface
 * is one line here rather than an edit in three files that will fall out of step.
 *
 * It mirrors @rxova/brand's `SiteShell` header — the sticky, translucent bar with
 * the theme toggle inside it — because /blog and /updates render that shell and
 * the landing must not drift from them. `SiteShell` is a whole-document layout
 * (it owns <html> and <head>), so the landing cannot mount it; this reproduces
 * only its header, and any change to one has to be made in the other.
 *
 * Not shared with the docs sites at /packages/*: those are Starlight, and their
 * chrome comes from @rxova/brand over npm. Cross-linking to them is the project
 * switcher's job.
 */
import ThemeToggle from '@rxova/brand/components/ThemeToggle.astro'
import { siteSurfaces } from '../lib/projects'

interface Props {
  /** Current path, so the active item can be marked. */
  path: string
}

const { path } = Astro.props

// Projects is always here; the rest are whatever is actually mounted. A surface
// that has not shipped its first build yet is absent from the menu rather than
// linking to a 404 — see `siteSurfaces`.
const items = [{ label: 'Projects', href: '/' }, ...siteSurfaces]

/** `/` matches only itself; everything else matches its whole subtree. */
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href))
---

{
  /* Full-bleed so the bar can span the viewport while its contents stay on the
    page's measure. Sticky rather than fixed: it still takes part in layout, so
    the page below needs no compensating top margin. */
}
<header class="site">
  <div class="site__inner">
    <a class="brand" href="/">
      <img src="/rxova-logo-256.png" alt="" width="28" height="28" />
      <span>rxova</span>
    </a>
    <nav aria-label="Sections">
      {
        items.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    {/* In the header, not floating over it — see ThemeToggle's `floating`. */}
    <ThemeToggle floating={false} />
  </div>
</header>

<style>
  /* Sticky, translucent, full-bleed. It was a plain in-flow row with the theme
     button floating over its right end, which on a phone put the button on top
     of the nav links and left the header behind as soon as you scrolled. */
  .site {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
  }

  /* The blur is what keeps text legible as it passes under the bar. Where it is
     unsupported the background falls back to nearly opaque, which is why the mix
     above is 88% and not 60%. */
  @supports (backdrop-filter: blur(8px)) or (-webkit-backdrop-filter: blur(8px)) {
    .site {
      background: color-mix(in srgb, var(--bg) 72%, transparent);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
    }
  }

  .site__inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    /* No wrapping: a two-line header would eat a phone's viewport, and the row
       is sized to fit at the narrowest widths we support. */
    min-height: 3.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--fg);
    text-decoration: none;
    font-weight: 640;
    letter-spacing: -0.01em;
  }
  .brand img {
    display: block;
    border-radius: 6px;
  }

  /* The nav takes the space between the brand and the toggle, and pushes itself
     to the right of it. */
  nav {
    margin-left: auto;
    display: flex;
    gap: 1.4rem;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--fg);
  }
  /* The current section is marked for everyone, not only for assistive tech —
     aria-current on its own is invisible. */
  nav a[aria-current='page'] {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  nav a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Brand mark, the links and the toggle stay on one row at the narrowest phones
     by dropping the wordmark — the logo carries the identity in the space left. */
  @media (max-width: 34rem) {
    .site__inner {
      gap: 0.75rem;
      padding-inline: 1rem;
      min-height: 3.25rem;
    }
    nav {
      gap: 0.9rem;
    }
    nav a {
      font-size: 0.875rem;
    }
    .brand span {
      display: none;
    }
  }
</style>

<!-- Global because `html` sits outside Astro's scoping. Without it a jump to an
     in-page anchor would land under the sticky header. -->
<style is:global>
  html {
    scroll-padding-top: 4.5rem;
  }
</style>
