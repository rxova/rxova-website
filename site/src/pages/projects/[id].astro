---
/**
 * /projects/<id>/ — one page per project, standing on its own.
 *
 * The home page is for choosing between projects and the docs at
 * /packages/<id>/ are for using one; this is the step between them. Someone
 * arriving from a search result or a shared link should be able to tell, on
 * this page alone, what the project is, what it looks like in code, and where
 * to go next — without having seen the landing first.
 *
 * Built by this repo, not mounted, so every project gets one — including one
 * whose docs are switched off in sources.json. Its page is where "Docs coming
 * soon" is said plainly, rather than a link to a mount that is not there.
 *
 * Everything on it is read from the same registries as the landing (see
 * ../../lib/projects.ts), so the two cannot describe a project differently.
 */
import type { GetStaticPaths } from 'astro'
import { siteUrl } from '@rxova/brand'
import { landingProjects, type LandingProject } from '../../lib/projects'
import { MAINTAINER, PRINCIPLES } from '../../lib/about'
import BaseLayout from '../../layouts/BaseLayout.astro'
import InstallLine from '../../components/InstallLine.astro'
import ProjectLinks from '../../components/ProjectLinks.astro'
import ProjectTile from '../../components/ProjectTile.astro'
// See ../../styles/chrome.css for why the reset is imported per page rather than
// by BaseLayout.
import '../../styles/global.css'

export const getStaticPaths = (() =>
  landingProjects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }))) satisfies GetStaticPaths

interface Props {
  project: LandingProject
}

const { project: p } = Astro.props
const others = landingProjects.filter((o) => o.id !== p.id)

const title = `${p.label} — Rxova`
const ogImage = `https://rxova.org/og/${p.id}.png`

// Same shape the landing's `hasPart` uses for this project, as the page's own
// subject. `url` is this page, which exists for every project, so unlike the
// landing's list it never needs gating on whether the docs are mounted.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: p.label,
  description: p.tagline,
  url: siteUrl(p.overview),
  codeRepository: p.repo,
  programmingLanguage: 'TypeScript',
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Person', name: MAINTAINER.name },
  isPartOf: { '@type': 'Organization', name: 'Rxova', url: siteUrl('/') },
}

// Escaped so a `</script>` inside any of the copy cannot close the element
// early — the same treatment as the landing's organisation block.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c')
---

<BaseLayout title={title} path={p.overview} wide>
  <Fragment slot="head">
    <meta name="description" content={`${p.label}: ${p.tagline}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={p.tagline} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl(p.overview)} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={jsonLdText}></script>
  </Fragment>

  <main>
    <a class="back" href="/#projects">
      <span aria-hidden="true">←</span> All projects
    </a>

    <header class="hero">
      <h1>{p.label}</h1>
      <p class="tagline">{p.tagline}</p>
      <ul class="tags" aria-label={`${p.label} tech`}>
        {p.tags.map((t) => (
          <li>{t}</li>
        ))}
      </ul>

      {/* One primary action. Docs when they are mounted; otherwise the repo,
          and the honest reason there is no docs button. */}
      <div class="cta-row">
        {p.docsMounted ? (
          <a class="btn btn-primary" href={p.mount}>
            Get started
            <span aria-hidden="true" class="arrow">
              →
            </span>
          </a>
        ) : (
          <>
            <a class="btn btn-primary" href={p.repo} target="_blank" rel="noopener noreferrer">
              View on GitHub
              <span aria-hidden="true" class="arrow">
                ↗
              </span>
            </a>
            <span class="soon">Docs coming soon</span>
          </>
        )}
      </div>
    </header>

    <div class="body">
      <div class="primary">
        {/* The code first. Frontend readers decide on what an API looks like
            faster than on any description of it. */}
        <section aria-labelledby="try-heading">
          <h2 id="try-heading">Try it</h2>
          <InstallLine pkg={p.install} />
          {p.snippet && <pre class="snippet" set:text={p.snippet}></pre>}
        </section>

        <section aria-labelledby="solves-heading">
          <h2 id="solves-heading">What it solves</h2>
          <p class="prose">{p.blurb}</p>
        </section>

        <section aria-labelledby="features-heading">
          <h2 id="features-heading">What you get</h2>
          <ul class="features">
            {p.features.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </section>
      </div>

      <aside class="secondary" aria-label={`${p.label} packages and links`}>
        <section aria-labelledby="packages-heading">
          <h2 id="packages-heading">Packages</h2>
          <ul class="packages">
            {p.packageLinks.map((pkg) => (
              <li>
                <a href={pkg.href} target="_blank" rel="noopener noreferrer">
                  {pkg.name}
                  <span aria-hidden="true" class="arrow">
                    ↗
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="links-heading">
          <h2 id="links-heading">Links</h2>
          <ProjectLinks links={p.links} label={`${p.label} links`} />
        </section>
      </aside>
    </div>

    {/* What this project shares with the rest. Each rule links to its long
        form on /about, under the same id the landing's principles use. */}
    <section class="band" aria-labelledby="rxova-heading">
      <h2 id="rxova-heading">Part of Rxova</h2>
      <p class="prose band-lede">
        {p.label} is one of a set of independent libraries held to the same rules. Adopt it on its
        own; nothing else from Rxova comes with it.
      </p>
      <ul class="principles">
        {PRINCIPLES.map((pr) => (
          <li>
            <a class="principle-title" href={`/about#${pr.id}`}>
              {pr.title}
            </a>
            <p>{pr.summary}</p>
          </li>
        ))}
      </ul>
    </section>

    {others.length > 0 && (
      <section class="band" aria-labelledby="more-heading">
        <h2 id="more-heading">More from Rxova</h2>
        <div class="tiles">
          {others.map((o) => (
            <ProjectTile project={o} />
          ))}
        </div>
      </section>
    )}
  </main>

  <style>
    main {
      max-width: var(--max);
      margin: 0 auto;
      padding: clamp(1.5rem, 4vh, 2.25rem) 1.5rem 5rem;
    }

    .prose,
    .tagline {
      max-width: 40rem;
    }

    .back {
      display: inline-flex;
      gap: 0.4rem;
      font-size: 0.88rem;
      color: var(--rx-muted);
      text-decoration: none;
    }

    .back:hover {
      color: var(--rx-fg);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    /* --- Hero ---------------------------------------------------------- */
    .hero {
      padding-block: clamp(1.5rem, 5vh, 2.75rem) clamp(2rem, 5vh, 3rem);
      border-bottom: 1px solid var(--rx-rule);
    }

    h1 {
      font-size: clamp(2rem, 5vw, 2.9rem);
      line-height: 1.1;
      letter-spacing: -0.03em;
      font-weight: 680;
    }

    .tagline {
      margin-top: 0.6rem;
      font-size: clamp(1.05rem, 2vw, 1.25rem);
      color: var(--rx-muted);
      text-wrap: pretty;
    }

    .tags {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 1.1rem;
    }

    .tags li {
      font-size: 0.72rem;
      color: var(--rx-muted);
      border: 1px solid var(--rx-rule-strong);
      padding: 0.12rem 0.6rem;
      border-radius: var(--rx-radius-pill);
    }

    .cta-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1rem;
      margin-top: 1.6rem;
    }

    /* The landing's primary button: solid ink straight off the tokens, so it
       inverts with the palette. */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.62rem 1.1rem;
      border-radius: var(--rx-radius-pill);
      font-size: 0.95rem;
      font-weight: 550;
      text-decoration: none;
      transition:
        transform 0.18s cubic-bezier(0.2, 0.7, 0.2, 1),
        background-color 0.18s ease;
    }

    .btn-primary {
      background: var(--rx-fg);
      color: var(--rx-bg);
    }

    .btn-primary:hover {
      background: color-mix(in srgb, var(--rx-fg) 88%, var(--rx-bg));
      transform: translateY(-1px);
    }

    .btn:focus-visible {
      outline: 2px solid var(--rx-fg);
      outline-offset: 3px;
    }

    .soon {
      font-size: 0.9rem;
      color: var(--rx-faint);
    }

    /* --- Body: the code and the claims, with packages and links beside -- */
    .body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 18rem);
      gap: clamp(2rem, 5vw, 4rem);
      padding-block: clamp(2rem, 5vh, 3rem);
    }

    .primary,
    .secondary {
      display: flex;
      flex-direction: column;
      gap: 2.25rem;
      min-width: 0;
    }

    h2 {
      font-family: var(--rx-font-mono);
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--rx-faint);
      margin-bottom: 0.9rem;
    }

    .prose {
      color: var(--rx-muted);
      font-size: 1.02rem;
    }

    .snippet {
      font-family: var(--rx-font-mono);
      font-size: 0.8rem;
      line-height: 1.7;
      color: var(--rx-muted);
      background: var(--rx-card);
      border: 1px solid var(--rx-rule);
      border-radius: var(--rx-radius-sm);
      padding: 1rem 1.1rem;
      margin-top: 0.9rem;
      /* Code sets its own line breaks, so the block scrolls rather than the page. */
      overflow-x: auto;
    }

    .features {
      list-style: none;
      display: grid;
      gap: 0.75rem;
      max-width: 42rem;
    }

    /* A gradient tick per line — the brand's one chroma, spent on marks. */
    .features li {
      position: relative;
      padding-left: 1.25rem;
    }

    .features li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.62em;
      width: 7px;
      height: 7px;
      border-radius: var(--rx-radius-pill);
      background: var(--rx-gradient);
    }

    .packages {
      list-style: none;
      display: grid;
      gap: 0.45rem;
    }

    .packages a {
      display: inline-flex;
      align-items: baseline;
      gap: 0.35rem;
      font-family: var(--rx-font-mono);
      font-size: 0.82rem;
      text-decoration: none;
      overflow-wrap: anywhere;
    }

    .packages a:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .arrow {
      opacity: 0.7;
      font-size: 0.85em;
    }

    /* --- Bands --------------------------------------------------------- */
    .band {
      padding-block: clamp(2.5rem, 7vh, 4rem);
      border-top: 1px solid var(--rx-rule);
    }

    .band + .band {
      padding-bottom: 0;
    }

    .band-lede {
      margin-bottom: 1.75rem;
    }

    .principles {
      list-style: none;
      display: grid;
      gap: 1.5rem 2.5rem;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    }

    .principle-title {
      display: inline-block;
      font-weight: 620;
      letter-spacing: -0.015em;
      margin-bottom: 0.35rem;
      text-decoration: none;
    }

    .principle-title:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .principles p {
      color: var(--rx-muted);
      font-size: 0.93rem;
    }

    .tiles {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    }

    @media (max-width: 52rem) {
      .body {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media (max-width: 40rem) {
      main {
        padding-inline: 1.25rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .btn {
        transition: none;
      }

      .btn-primary:hover {
        transform: none;
      }
    }
  </style>
</BaseLayout>
