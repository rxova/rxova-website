---
import "../styles/global.css";

const authorGithub = "https://github.com/rxova";
const authorEmail = "rxova@proton.me";

type Link = { label: string; href: string; external?: boolean };
type Project = {
  name: string;
  kicker: string;
  tagline: string;
  blurb: string;
  links: Link[];
};

const projects: Project[] = [
  {
    name: "Journey",
    kicker: "@rxova/journey",
    tagline: "Declarative journey graphs for non-linear UI flows.",
    blurb:
      "Model multi-step, branching flows as a graph instead of a tangle of booleans and effects. Core is framework-agnostic; React bindings and a Chrome DevTools bridge come in the box.",
    links: [
      { label: "Docs", href: "/packages/journey/" },
      { label: "GitHub", href: "https://github.com/rxova/journey", external: true },
      {
        label: "npm",
        href: "https://www.npmjs.com/package/@rxova/journey-core",
        external: true,
      },
    ],
  },
  {
    name: "rxova inputs",
    kicker: "react inputs",
    tagline: "Small, correct, dependency-light React inputs.",
    blurb:
      "A family of focused input components — localized currency, OTP slots, and feedback stars — each zero-to-few dependencies, accessible, and free of the usual cursor and locale bugs.",
    links: [
      { label: "Docs", href: "/packages/inputs/" },
      { label: "GitHub", href: "https://github.com/rxova/inputs", external: true },
    ],
  },
  {
    name: "use-everywhere",
    kicker: "react state",
    // TODO(you): confirm this tagline matches the project's own wording.
    tagline: "Reach your React state from anywhere, without prop-drilling.",
    blurb:
      "A tiny primitive for sharing state and hooks across a tree without ceremony. Core plus React bindings.",
    links: [
      {
        label: "Docs",
        href: "https://rxova.github.io/use-everywhere",
        external: true,
      },
      {
        label: "GitHub",
        href: "https://github.com/rxova/use-everywhere",
        external: true,
      },
      {
        label: "npm",
        href: "https://www.npmjs.com/package/use-everywhere",
        external: true,
      },
    ],
  },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/rxova-logo-256.png" />
    <title>rxova — open-source React libraries</title>
    <meta
      name="description"
      content="rxova — open-source React libraries: Journey, rxova inputs, and use-everywhere."
    />
    <meta property="og:title" content="rxova" />
    <meta
      property="og:description"
      content="Open-source React libraries: Journey, rxova inputs, and use-everywhere."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rxova.org/" />
    <meta property="og:image" content="https://rxova.org/rxova-logo-1024.png" />
    <script is:inline>
      // Apply the saved theme before paint to avoid a flash. No choice saved =>
      // fall through to the CSS prefers-color-scheme default.
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark")
            document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme">
      <span aria-hidden="true">☾</span>
    </button>
    <main>
      <header class="intro">
        <img
          class="mark"
          src="/rxova-logo-256.png"
          alt="rxova"
          width="48"
          height="48"
        />
        <h1>Building open-source React libraries the way they should be.</h1>
        <p class="lede">
          <strong>rxova</strong> is a small family of React tools — each does one
          thing well, stays dependency-light, and gets out of your way.
        </p>
      </header>

      <section class="projects" aria-label="Projects">
        {
          projects.map((p) => (
            <article class="project">
              <div class="project-head">
                <span class="kicker">{p.kicker}</span>
                <h2>{p.name}</h2>
              </div>
              <p class="tagline">{p.tagline}</p>
              <p class="blurb">{p.blurb}</p>
              <nav class="links" aria-label={`${p.name} links`}>
                {p.links.map((l) => (
                  <a
                    href={l.href}
                    {...(l.external
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    {l.label}
                    <span aria-hidden="true" class="arrow">
                      {l.external ? "↗" : "→"}
                    </span>
                  </a>
                ))}
              </nav>
            </article>
          ))
        }
      </section>

      <footer class="foot">
        <span>© {year} rxova</span>
        <span class="dot" aria-hidden="true">·</span>
        <a href={authorGithub} target="_blank" rel="noopener noreferrer"
          >GitHub</a
        >
        <span class="dot" aria-hidden="true">·</span>
        <a href={`mailto:${authorEmail}`}>Email</a>
      </footer>
    </main>

    <style>
      main {
        max-width: var(--max);
        margin: 0 auto;
        padding: clamp(3rem, 10vh, 7rem) 1.5rem 4rem;
      }

      .intro .mark {
        display: block;
        width: 48px;
        height: 48px;
        border-radius: 10px;
        margin-bottom: 2rem;
      }

      .intro h1 {
        font-size: clamp(1.7rem, 4.5vw, 2.4rem);
        line-height: 1.15;
        letter-spacing: -0.02em;
        font-weight: 650;
        margin-bottom: 1.1rem;
      }

      .lede {
        color: var(--muted);
        font-size: 1.15rem;
        max-width: 34rem;
      }

      .projects {
        margin-top: clamp(3rem, 8vh, 5rem);
        display: flex;
        flex-direction: column;
        gap: 0;
      }

      .project {
        padding: 2.25rem 0;
        border-top: 1px solid var(--rule);
      }

      .project-head {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 0.6rem;
      }

      .kicker {
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--faint);
        background: var(--tag-bg);
        padding: 0.15rem 0.5rem;
        border-radius: 5px;
        letter-spacing: -0.01em;
      }

      .project h2 {
        font-size: 1.5rem;
        letter-spacing: -0.02em;
        font-weight: 640;
      }

      .tagline {
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
      }

      .blurb {
        color: var(--muted);
        max-width: 38rem;
        margin-bottom: 1.1rem;
      }

      .links {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
      }

      .links a {
        text-decoration: none;
        font-weight: 550;
        font-size: 0.97rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        border-bottom: 1px solid transparent;
        transition: border-color 0.15s ease;
      }

      .links a:hover {
        border-bottom-color: var(--fg);
      }

      .arrow {
        color: var(--faint);
        font-size: 0.85em;
        transition: transform 0.15s ease;
      }

      .links a:hover .arrow {
        transform: translate(1px, -1px);
      }

      .foot {
        margin-top: clamp(3rem, 8vh, 5rem);
        padding-top: 1.75rem;
        border-top: 1px solid var(--rule);
        color: var(--faint);
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
      }

      .foot a {
        color: var(--muted);
        text-decoration: none;
      }

      .foot a:hover {
        color: var(--fg);
      }

      .dot {
        color: var(--rule);
      }

      .theme-toggle {
        position: fixed;
        top: 1rem;
        right: 1rem;
        width: 2.25rem;
        height: 2.25rem;
        display: grid;
        place-items: center;
        border: 1px solid var(--rule);
        border-radius: 8px;
        background: var(--card);
        color: var(--fg);
        font-size: 1rem;
        line-height: 1;
        cursor: pointer;
        z-index: 3;
        transition: border-color 0.15s ease, background-color 0.2s ease;
      }

      .theme-toggle:hover {
        border-color: var(--faint);
      }

      .theme-toggle:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
    </style>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById("theme-toggle");
        var glyph = btn.firstElementChild;
        var media = window.matchMedia("(prefers-color-scheme: dark)");

        function current() {
          return (
            root.getAttribute("data-theme") ||
            (media.matches ? "dark" : "light")
          );
        }
        function render() {
          var dark = current() === "dark";
          glyph.textContent = dark ? "☀" : "☾";
          btn.setAttribute(
            "aria-label",
            dark ? "Switch to light theme" : "Switch to dark theme"
          );
        }
        function apply(t) {
          root.setAttribute("data-theme", t);
          try {
            localStorage.setItem("theme", t);
          } catch (e) {}
          render();
        }

        btn.addEventListener("click", function () {
          apply(current() === "dark" ? "light" : "dark");
        });
        // Track the OS preference while the user hasn't overridden it.
        media.addEventListener("change", function () {
          if (!root.getAttribute("data-theme")) render();
        });
        render();

        // Cursor-following glow (skipped for reduced-motion users).
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          var raf = 0;
          var main = document.querySelector("main");
          window.addEventListener(
            "pointermove",
            function (e) {
              if (raf) return;
              var x = e.clientX,
                y = e.clientY;
              raf = requestAnimationFrame(function () {
                root.style.setProperty("--mx", x + "px");
                root.style.setProperty("--my", y + "px");
                // Fade the glow out over the centred text column; it only shows
                // in the empty side margins.
                var r = main.getBoundingClientRect();
                var overText =
                  x >= r.left && x <= r.right && y >= r.top && y <= r.bottom;
                root.style.setProperty("--glow-o", overText ? "0" : "1");
                raf = 0;
              });
            },
            { passive: true }
          );
        }
      })();
    </script>
  </body>
</html>
