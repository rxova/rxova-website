---
// The project list is assembled from @rxova/brand (product metadata, shared with
// the docs sites) and sources.json (landing copy + what is actually deployed).
// See src/lib/projects.ts — it fails the build if the two disagree.
import { siteUrl } from '@rxova/brand'
import { landingProjects, projectListSentence } from '../lib/projects'
// Who maintains this and what the projects share — the short form of both. The
// long form is /about, and both read from the same module so they cannot drift.
import { MAINTAINER, PRINCIPLES } from '../lib/about'
import BaseLayout from '../layouts/BaseLayout.astro'
// The reset and base element styling this page's scoped CSS is written against.
// It lives here rather than in BaseLayout because BaseLayout also builds the
// shell templates, which must not carry it into a docs page — see the stylesheet.
import '../styles/global.css'

/**
 * Who publishes these, and what they are, in the vocabulary a crawler parses.
 *
 * The `Organization` is what ties the npm scope, the GitHub org and this domain
 * together as one entity rather than three unrelated names; `hasPart` lists the
 * projects so the landing declares the set it links to. Everything is read from
 * the same registries the page renders from, so adding a project updates the
 * structured data with it — the failure mode this avoids is a hand-written block
 * that describes the site as it was the last time someone remembered to edit it.
 */
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Rxova',
  url: siteUrl('/'),
  logo: siteUrl('/rxova-logo-1024.png'),
  description: `Small TypeScript libraries for the hard parts of the browser: ${projectListSentence}.`,
  founder: { '@type': 'Person', name: MAINTAINER.name },
  sameAs: [MAINTAINER.org, ...MAINTAINER.links.map((l) => l.href)],
  hasPart: landingProjects.map((p) => ({
    '@type': 'SoftwareSourceCode',
    name: p.label,
    description: p.tagline,
    url: siteUrl(p.mount),
    codeRepository: p.repo,
    programmingLanguage: 'TypeScript',
    license: 'https://opensource.org/licenses/MIT',
  })),
}

// Escaped so a `</script>` inside any of the copy above cannot close the element
// early and spill the rest into the document as text. `<` is valid JSON and
// parses back to `<`, so the structured data is unchanged.
const organizationJson = JSON.stringify(organizationJsonLd).replace(/</g, '\\u003c')

const blogFeed = siteUrl('/blog/rss.xml')
---

<BaseLayout title="Rxova — TypeScript libraries for the hard parts of the browser" path="/">
  <Fragment slot="head">
    <!-- Project names come from the registry, so adding a project updates the
         meta descriptions too. They used to be hand-written and were the easiest
         thing to forget.

         "React libraries" here was wrong as well as forgettable: two of the three
         ship a framework-agnostic core that runs in a worker or a plain script,
         and Journey also ships a browser extension. React is a binding we
         provide, not the boundary of what these are. -->
    <meta
      name="description"
      content={`Rxova — small TypeScript libraries for the hard parts of the browser: ${projectListSentence}.`}
    />
    <meta property="og:title" content="Rxova" />
    <meta
      property="og:description"
      content={`Small TypeScript libraries for the hard parts of the browser: ${projectListSentence}.`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rxova.org/" />
    <!-- A proper 1200x630 card. The square 1024px logo this used to point at
         gets centre-cropped by Slack and Twitter into an unreadable smear. -->
    <meta property="og:image" content="https://rxova.org/og/rxova.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- The blog is mounted here but built in the brand repo, so the landing is
         the only place that can advertise its feed from the domain root. -->
    <link rel="alternate" type="application/rss+xml" title="Rxova Blog" href={blogFeed} />
    <script type="application/ld+json" is:inline set:html={organizationJson} />
  </Fragment>
  <main>
    {
      /* The hero names the problems rather than praising the solutions. It
          used to read "Building open-source React libraries the way they should
          be" over "each does one thing well … and gets out of your way", which
          asserted quality instead of showing any, and called the whole family
          React when only react-inputs actually is. */
    }
    <header class="intro">
      <h1>Small TypeScript libraries for the hard parts of the browser.</h1>
      <p class="lede">
        Cross-tab state. Non-linear flows. The inputs nobody wants to build and everybody wants to
        import. <strong>Rxova</strong> ships framework-agnostic cores, React bindings where they earn
        their place, and APIs small enough to stay still.
      </p>
    </header>

    <section class="projects" aria-label="Projects">
      {
        landingProjects.map((p) => (
          <article class="project">
            <h2 class="project-title">{p.label}</h2>
            <ul class="packages" aria-label={`${p.label} packages`}>
              {p.packages.map((pkg) => (
                <li class="pkg">{pkg}</li>
              ))}
            </ul>
            <p class="tagline">{p.tagline}</p>
            <p class="blurb">{p.blurb}</p>
            {/* The page described three libraries and gave a reader no way to
                try one. The install line is the shortest possible next step, and
                the snippet is the claim the whole site makes — that these APIs
                are small — shown instead of asserted. */}
            <p class="install">
              <span class="prompt" aria-hidden="true">
                $
              </span>
              <code>npm i {p.install}</code>
            </p>
            {/* Self-closing with `set:text` rather than `<pre><code>{…}</code></pre>`.
                Whitespace inside `<pre>` renders, and the formatter breaks a
                nested element onto its own line — which put a blank first line
                and eight spaces of indentation into every snippet. An element
                with no children cannot pick up stray text nodes. */}
            {p.snippet && <pre class="snippet" set:text={p.snippet} />}
            <ul class="tags" aria-label={`${p.label} tech`}>
              {p.tags.map((t) => (
                <li class="tag">{t}</li>
              ))}
            </ul>
            <nav class="links" aria-label={`${p.label} links`}>
              {p.links.map((l) => (
                <a
                  href={l.href}
                  {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {l.label}
                  <span aria-hidden="true" class="arrow">
                    {l.external ? '↗' : '→'}
                  </span>
                </a>
              ))}
            </nav>
          </article>
        ))
      }
    </section>

    {
      /* Why these three are one ecosystem. It comes after the project list
          rather than before it: the principles mean something once you have
          seen what they produced, and nothing at all as an opening claim. */
    }
    <section class="why" aria-labelledby="why-heading">
      <h2 id="why-heading">Why Rxova</h2>
      <p class="why-lede">
        Three projects, one set of rules. These are what Journey, react-inputs and use-everywhere
        have in common — and what they are held to.
      </p>
      <ul class="principles">
        {
          PRINCIPLES.map((p) => (
            <li class="principle">
              <h3 class="principle-title">{p.title}</h3>
              <p class="principle-summary">{p.summary}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      /* The maintainer, named. A visitor deciding whether to depend on any of
          this wants to know who is behind it and whether it is still moving;
          both were previously unanswerable anywhere on the site. */
    }
    <section class="maintainer" aria-labelledby="maintainer-heading">
      <h2 id="maintainer-heading">Built and maintained by {MAINTAINER.name}</h2>
      <p class="maintainer-summary">{MAINTAINER.summary}</p>
      <nav class="links" aria-label="About the maintainer">
        <a href="/about">
          About Rxova
          <span aria-hidden="true" class="arrow">→</span>
        </a>
        {
          MAINTAINER.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer">
              {l.label}
              <span aria-hidden="true" class="arrow">
                ↗
              </span>
            </a>
          ))
        }
      </nav>
    </section>

    {
      /* The page ended without asking for anything. These are the two things a
          reader can actually give a young project — attention now, and attention
          later — and both are one click. Kept to a strip rather than a section
          with a heading: it is an ask, not a chapter. */
    }
    <section class="follow" aria-labelledby="follow-heading">
      <h2 id="follow-heading">Follow along</h2>
      <p class="follow-summary">
        Everything here is new and moving. Starring a repo is what tells me which of these is worth
        the next month of work.
      </p>
      <nav class="links" aria-label="Follow Rxova">
        <a href={MAINTAINER.org} target="_blank" rel="noopener noreferrer">
          Star on GitHub
          <span aria-hidden="true" class="arrow">↗</span>
        </a>
        <a href="/updates">
          What changed
          <span aria-hidden="true" class="arrow">→</span>
        </a>
        <a href={blogFeed}>
          RSS
          <span aria-hidden="true" class="arrow">→</span>
        </a>
      </nav>
    </section>

    {
      /* The shared footer from @rxova/brand — the same one /blog, /updates and
          the docs sites render. This page used to carry its own dot-separated
          link row, which is why it stayed a single line while every other
          surface grew the four-column one. */
    }
  </main>

  <style>
    main {
      max-width: var(--max);
      margin: 0 auto;
      padding: clamp(2rem, 6vh, 3.5rem) 1.5rem 4rem;
    }

    .intro h1 {
      font-size: clamp(1.7rem, 4.5vw, 2.4rem);
      line-height: 1.15;
      letter-spacing: -0.02em;
      font-weight: 650;
      margin-bottom: 1.1rem;
    }

    .lede {
      color: var(--muted);
      font-size: 1.15rem;
      max-width: 34rem;
    }

    .projects {
      margin-top: clamp(3rem, 8vh, 5rem);
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .project {
      padding: 2.25rem 0;
      border-top: 1px solid var(--rule);
    }

    .project-title {
      font-size: 1.5rem;
      letter-spacing: -0.02em;
      font-weight: 640;
      margin-bottom: 0.7rem;
    }

    .packages {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 0.95rem;
    }

    .pkg {
      font-family: var(--mono);
      font-size: 0.75rem;
      line-height: 1.4;
      color: var(--faint);
      background: var(--tag-bg);
      padding: 0.15rem 0.5rem;
      border-radius: 5px;
      letter-spacing: -0.01em;
    }

    .tagline {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
    }

    .blurb {
      color: var(--muted);
      max-width: 38rem;
      margin-bottom: 1.1rem;
    }

    /* The install line reads as a terminal without pretending to be one: a
       dimmed prompt, the command in the mono face, and a rule rather than a
       filled block so it does not outweigh the blurb above it. */
    .install {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      font-family: var(--mono);
      font-size: 0.82rem;
      border: 1px solid var(--rule);
      border-radius: 6px;
      padding: 0.5rem 0.7rem;
      margin-bottom: 0.9rem;
      /* Long scoped package names must not widen the card on a phone. */
      overflow-x: auto;
    }

    .install .prompt {
      color: var(--faint);
      user-select: none;
    }

    .install code {
      white-space: nowrap;
    }

    .snippet {
      font-family: var(--mono);
      font-size: 0.78rem;
      line-height: 1.65;
      color: var(--muted);
      background: var(--tag-bg);
      border-radius: 6px;
      padding: 0.8rem 0.9rem;
      margin-bottom: 1.1rem;
      max-width: 38rem;
      /* Code sets its own line breaks, so the block scrolls rather than the page. */
      overflow-x: auto;
    }

    .tags {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 1.25rem;
    }

    .tag {
      font-size: 0.72rem;
      color: var(--muted);
      border: 1px solid var(--rule);
      padding: 0.12rem 0.55rem;
      border-radius: 999px;
      letter-spacing: 0.01em;
    }

    .links {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .links a {
      text-decoration: none;
      font-weight: 550;
      font-size: 0.97rem;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      border-bottom: 1px solid transparent;
      transition: border-color 0.15s ease;
    }

    .links a:hover {
      border-bottom-color: var(--fg);
    }

    .arrow {
      color: var(--faint);
      font-size: 0.85em;
      transition: transform 0.15s ease;
    }

    .links a:hover .arrow {
      transform: translate(1px, -1px);
    }

    /* The two sections below are new work, so they use @rxova/brand's --rx-*
         tokens directly rather than the short aliases the rules above were
         written against. Same values — see the package's astro.css. */

    /* Both sit on the same top rule the project cards use, so the page reads
         as one column of sections rather than a list plus two appendices. */
    .why,
    .maintainer,
    .follow {
      padding: 2.25rem 0;
      border-top: 1px solid var(--rx-rule);
    }

    .why h2,
    .maintainer h2,
    .follow h2 {
      font-size: 1.5rem;
      letter-spacing: -0.02em;
      font-weight: 640;
      margin-bottom: 0.7rem;
    }

    .why-lede {
      color: var(--rx-muted);
      max-width: 38rem;
      margin-bottom: 2rem;
    }

    .principles {
      list-style: none;
      display: grid;
      gap: 1.75rem 2.5rem;
      /* Two columns where there is room for them, one where there is not. The
           four principles are meant to be read as a set, and a single tall
           column pushes the fourth off the fold on a laptop. */
      grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    }

    .principle-title {
      font-size: 1.02rem;
      font-weight: 620;
      letter-spacing: -0.01em;
      margin-bottom: 0.35rem;
    }

    /* The rule's accent, on the title rather than around the whole card: the
         section stays flat like the rest of the page. */
    .principle {
      border-left: 2px solid var(--rx-rule-strong);
      padding-left: 1rem;
    }

    .principle-summary {
      color: var(--rx-muted);
      font-size: 0.97rem;
    }

    .maintainer-summary,
    .follow-summary {
      color: var(--rx-muted);
      max-width: 38rem;
      margin-bottom: 1.25rem;
    }

    /* No `:global(.rx-footer)` rule here any more. This page used to set
         `margin-top: clamp(3rem, 8vh, 5rem)`, /about copied it, and Legal.astro
         set 3rem — three values for one piece of shared chrome, so the gap above
         the footer differed on every surface and none matched /blog or /updates,
         which take the 4rem from @rxova/brand's footer.css. That file is now the
         only owner of the footer's spacing. */
  </style>
</BaseLayout>
