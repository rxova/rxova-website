---
import '../styles/global.css'

const authorGithub = 'https://github.com/rxova'
const authorEmail = 'rxova@proton.me'

type Link = { label: string; href: string; external?: boolean }
type Project = {
  name: string
  packages: string[]
  tagline: string
  blurb: string
  tags: string[]
  links: Link[]
}

const projects: Project[] = [
  {
    name: 'Journey',
    packages: ['@rxova/journey-core', '@rxova/journey-react', '@rxova/journey-devtools-bridge'],
    tagline: 'Declarative journey graphs for non-linear UI flows.',
    blurb:
      'Model multi-step, branching flows as a graph instead of a tangle of booleans and effects. Core is framework-agnostic; React bindings and a Chrome DevTools bridge come in the box.',
    tags: ['JS Core', 'React', 'TypeScript', 'Chrome Extension'],
    links: [
      { label: 'Docs', href: '/packages/journey/' },
      { label: 'GitHub', href: 'https://github.com/rxova/journey', external: true },
      {
        label: 'npm',
        href: 'https://www.npmjs.com/package/@rxova/journey-core',
        external: true,
      },
    ],
  },
  {
    name: 'react-inputs',
    packages: [
      '@rxova/react-inputs',
      '@rxova/react-intl-currency-input',
      '@rxova/react-otp-input',
      '@rxova/react-rating-input',
    ],
    tagline: 'Small, correct, dependency-light React inputs.',
    blurb:
      'A family of focused input components — localized currency, OTP slots, and feedback stars — each zero-to-few dependencies, accessible, and free of the usual cursor and locale bugs.',
    tags: ['React', 'TypeScript', 'Zero-dependency', 'Accessible'],
    links: [
      { label: 'Docs', href: '/packages/react-inputs/' },
      { label: 'GitHub', href: 'https://github.com/rxova/react-inputs', external: true },
    ],
  },
  {
    name: 'use-everywhere',
    packages: ['@use-everywhere/core', 'use-everywhere'],
    tagline: 'State and messages that exist in every tab, window, and worker.',
    blurb:
      'Share state and messages across every tab, window, and worker — a framework-agnostic core plus React bindings, one small API.',
    tags: ['JS Core', 'React', 'TypeScript', 'Cross-tab'],
    links: [
      { label: 'Docs', href: '/packages/use-everywhere/' },
      {
        label: 'GitHub',
        href: 'https://github.com/rxova/use-everywhere',
        external: true,
      },
      {
        label: 'npm',
        href: 'https://www.npmjs.com/package/use-everywhere',
        external: true,
      },
    ],
  },
]

const year = new Date().getFullYear()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/rxova-logo-256.png" />
    <link rel="apple-touch-icon" href="/rxova-logo-256.png" />
    <title>rxova — open-source React libraries</title>
    <meta
      name="description"
      content="rxova — open-source React libraries: Journey, react-inputs, and use-everywhere."
    />
    <meta property="og:title" content="rxova" />
    <meta
      property="og:description"
      content="Open-source React libraries: Journey, react-inputs, and use-everywhere."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rxova.org/" />
    <meta property="og:image" content="https://rxova.org/rxova-logo-1024.png" />
    <script is:inline>
      // Apply the saved theme before paint to avoid a flash. No choice saved =>
      // fall through to the CSS prefers-color-scheme default.
      ;(function () {
        try {
          const t = localStorage.getItem('theme')
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t)
        } catch {
          /* localStorage may be unavailable */
        }
      })()
    </script>
  </head>
  <body>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme">
      <span class="icon" aria-hidden="true"
        ><svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg
        ></span
      >
    </button>
    <main>
      <header class="intro">
        <img class="mark" src="/rxova-logo-256.png" alt="rxova" width="48" height="48" />
        <h1>Building open-source React libraries the way they should be.</h1>
        <p class="lede">
          <strong>rxova</strong> is a small family of React tools — each does one thing well, stays dependency-light,
          and gets out of your way.
        </p>
      </header>

      <section class="projects" aria-label="Projects">
        {
          projects.map((p) => (
            <article class="project">
              <h2 class="project-title">{p.name}</h2>
              <ul class="packages" aria-label={`${p.name} packages`}>
                {p.packages.map((pkg) => (
                  <li class="pkg">{pkg}</li>
                ))}
              </ul>
              <p class="tagline">{p.tagline}</p>
              <p class="blurb">{p.blurb}</p>
              <ul class="tags" aria-label={`${p.name} tech`}>
                {p.tags.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
              <nav class="links" aria-label={`${p.name} links`}>
                {p.links.map((l) => (
                  <a
                    href={l.href}
                    {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {l.label}
                    <span aria-hidden="true" class="arrow">
                      {l.external ? '↗' : '→'}
                    </span>
                  </a>
                ))}
              </nav>
            </article>
          ))
        }
      </section>

      <footer class="foot">
        <span>© {year} rxova</span>
        <span class="dot" aria-hidden="true">·</span>
        <a href={authorGithub} target="_blank" rel="noopener noreferrer">GitHub</a>
        <span class="dot" aria-hidden="true">·</span>
        <a href={`mailto:${authorEmail}`}>Email</a>
        <span class="dot" aria-hidden="true">·</span>
        <a href="/privacy">Privacy</a>
        <span class="dot" aria-hidden="true">·</span>
        <a href="/terms">Terms</a>
      </footer>
    </main>

    <style>
      main {
        max-width: var(--max);
        margin: 0 auto;
        padding: clamp(3rem, 10vh, 7rem) 1.5rem 4rem;
      }

      .intro .mark {
        display: block;
        width: 48px;
        height: 48px;
        border-radius: 10px;
        margin-bottom: 2rem;
      }

      .intro h1 {
        font-size: clamp(1.7rem, 4.5vw, 2.4rem);
        line-height: 1.15;
        letter-spacing: -0.02em;
        font-weight: 650;
        margin-bottom: 1.1rem;
      }

      .lede {
        color: var(--muted);
        font-size: 1.15rem;
        max-width: 34rem;
      }

      .projects {
        margin-top: clamp(3rem, 8vh, 5rem);
        display: flex;
        flex-direction: column;
        gap: 0;
      }

      .project {
        padding: 2.25rem 0;
        border-top: 1px solid var(--rule);
      }

      .project-title {
        font-size: 1.5rem;
        letter-spacing: -0.02em;
        font-weight: 640;
        margin-bottom: 0.7rem;
      }

      .packages {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 0.95rem;
      }

      .pkg {
        font-family: var(--mono);
        font-size: 0.75rem;
        line-height: 1.4;
        color: var(--faint);
        background: var(--tag-bg);
        padding: 0.15rem 0.5rem;
        border-radius: 5px;
        letter-spacing: -0.01em;
      }

      .tagline {
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
      }

      .blurb {
        color: var(--muted);
        max-width: 38rem;
        margin-bottom: 1.1rem;
      }

      .tags {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 1.25rem;
      }

      .tag {
        font-size: 0.72rem;
        color: var(--muted);
        border: 1px solid var(--rule);
        padding: 0.12rem 0.55rem;
        border-radius: 999px;
        letter-spacing: 0.01em;
      }

      .links {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
      }

      .links a {
        text-decoration: none;
        font-weight: 550;
        font-size: 0.97rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        border-bottom: 1px solid transparent;
        transition: border-color 0.15s ease;
      }

      .links a:hover {
        border-bottom-color: var(--fg);
      }

      .arrow {
        color: var(--faint);
        font-size: 0.85em;
        transition: transform 0.15s ease;
      }

      .links a:hover .arrow {
        transform: translate(1px, -1px);
      }

      .foot {
        margin-top: clamp(3rem, 8vh, 5rem);
        padding-top: 1.75rem;
        border-top: 1px solid var(--rule);
        color: var(--faint);
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
      }

      .foot a {
        color: var(--muted);
        text-decoration: none;
      }

      .foot a:hover {
        color: var(--fg);
      }

      .dot {
        color: var(--rule);
      }

      .theme-toggle {
        position: fixed;
        top: 1rem;
        right: 1rem;
        width: 2.25rem;
        height: 2.25rem;
        display: grid;
        place-items: center;
        border: 1px solid var(--rule);
        border-radius: 8px;
        background: var(--card);
        color: var(--fg);
        cursor: pointer;
        z-index: 3;
        transition:
          border-color 0.15s ease,
          background-color 0.2s ease;
      }

      .theme-toggle .icon {
        display: grid;
        place-items: center;
      }

      .theme-toggle svg {
        width: 1.15rem;
        height: 1.15rem;
        display: block;
      }

      .theme-toggle:hover {
        border-color: var(--faint);
      }

      .theme-toggle:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
    </style>

    <script is:inline>
      ;(function () {
        const root = document.documentElement
        const btn = document.getElementById('theme-toggle')
        const glyph = btn.querySelector('.icon')
        const media = window.matchMedia('(prefers-color-scheme: dark)')

        // Lucide icons (ISC licensed).
        const ICON_MOON =
          '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>'
        const ICON_SUN =
          '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>'

        function current() {
          return root.getAttribute('data-theme') || (media.matches ? 'dark' : 'light')
        }
        function render() {
          const dark = current() === 'dark'
          // Show the icon of the theme you'd switch TO.
          glyph.innerHTML = dark ? ICON_SUN : ICON_MOON
          btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme')
        }
        function apply(t) {
          root.setAttribute('data-theme', t)
          try {
            localStorage.setItem('theme', t)
          } catch {
            /* localStorage may be unavailable */
          }
          render()
        }

        btn.addEventListener('click', function () {
          apply(current() === 'dark' ? 'light' : 'dark')
        })
        // Track the OS preference while the user hasn't overridden it.
        media.addEventListener('change', function () {
          if (!root.getAttribute('data-theme')) render()
        })
        render()
      })()
    </script>
  </body>
</html>
