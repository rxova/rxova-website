---
import '../styles/global.css'
// The project list is assembled from @rxova/brand (product metadata, shared with
// the docs sites) and sources.json (landing copy + what is actually deployed).
// See src/lib/projects.ts — it fails the build if the two disagree.
import { landingProjects, projectListSentence, siteSurfaces } from '../lib/projects'
import ThemeScript from '../components/ThemeScript.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import SiteHeader from '../components/SiteHeader.astro'

const authorGithub = 'https://github.com/rxova'
const authorEmail = 'rxova@proton.me'

const year = new Date().getFullYear()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/rxova-logo-256.png" />
    <link rel="apple-touch-icon" href="/rxova-logo-256.png" />
    <title>rxova — open-source React libraries</title>
    <!-- Project names come from the registry, so adding a project updates the
         meta descriptions too. They used to be hand-written and were the easiest
         thing to forget. -->
    <meta
      name="description"
      content={`rxova — open-source React libraries: ${projectListSentence}.`}
    />
    <meta property="og:title" content="rxova" />
    <meta
      property="og:description"
      content={`Open-source React libraries: ${projectListSentence}.`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rxova.org/" />
    <!-- A proper 1200x630 card. The square 1024px logo this used to point at
         gets centre-cropped by Slack and Twitter into an unreadable smear. -->
    <meta property="og:image" content="https://rxova.org/og/rxova.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <ThemeScript />
  </head>
  <body>
    <ThemeToggle />
    <main>
      <SiteHeader path="/" />

      <header class="intro">
        <h1>Building open-source React libraries the way they should be.</h1>
        <p class="lede">
          <strong>rxova</strong> is a small family of React tools — each does one thing well, stays dependency-light,
          and gets out of your way.
        </p>
      </header>

      <section class="projects" aria-label="Projects">
        {
          landingProjects.map((p) => (
            <article class="project">
              <h2 class="project-title">{p.label}</h2>
              <ul class="packages" aria-label={`${p.label} packages`}>
                {p.packages.map((pkg) => (
                  <li class="pkg">{pkg}</li>
                ))}
              </ul>
              <p class="tagline">{p.tagline}</p>
              <p class="blurb">{p.blurb}</p>
              <ul class="tags" aria-label={`${p.label} tech`}>
                {p.tags.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
              <nav class="links" aria-label={`${p.label} links`}>
                {p.links.map((l) => (
                  <a
                    href={l.href}
                    {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {l.label}
                    <span aria-hidden="true" class="arrow">
                      {l.external ? '↗' : '→'}
                    </span>
                  </a>
                ))}
              </nav>
            </article>
          ))
        }
      </section>

      <footer class="foot">
        <span>© {year} rxova</span>
        <span class="dot" aria-hidden="true">·</span>
        <a href={authorGithub} target="_blank" rel="noopener noreferrer">GitHub</a>
        <span class="dot" aria-hidden="true">·</span>
        <a href={`mailto:${authorEmail}`}>Email</a>
        <span class="dot" aria-hidden="true">·</span>
        {
          siteSurfaces.map((s) => (
            <>
              <a href={s.href}>{s.label}</a>
              <span class="dot" aria-hidden="true">
                ·
              </span>
            </>
          ))
        }
        <a href="/privacy">Privacy</a>
        <span class="dot" aria-hidden="true">·</span>
        <a href="/terms">Terms</a>
      </footer>
    </main>

    <style>
      main {
        max-width: var(--max);
        margin: 0 auto;
        padding: clamp(2rem, 6vh, 3.5rem) 1.5rem 4rem;
      }

      .intro h1 {
        font-size: clamp(1.7rem, 4.5vw, 2.4rem);
        line-height: 1.15;
        letter-spacing: -0.02em;
        font-weight: 650;
        margin-bottom: 1.1rem;
      }

      .lede {
        color: var(--muted);
        font-size: 1.15rem;
        max-width: 34rem;
      }

      .projects {
        margin-top: clamp(3rem, 8vh, 5rem);
        display: flex;
        flex-direction: column;
        gap: 0;
      }

      .project {
        padding: 2.25rem 0;
        border-top: 1px solid var(--rule);
      }

      .project-title {
        font-size: 1.5rem;
        letter-spacing: -0.02em;
        font-weight: 640;
        margin-bottom: 0.7rem;
      }

      .packages {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 0.95rem;
      }

      .pkg {
        font-family: var(--mono);
        font-size: 0.75rem;
        line-height: 1.4;
        color: var(--faint);
        background: var(--tag-bg);
        padding: 0.15rem 0.5rem;
        border-radius: 5px;
        letter-spacing: -0.01em;
      }

      .tagline {
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
      }

      .blurb {
        color: var(--muted);
        max-width: 38rem;
        margin-bottom: 1.1rem;
      }

      .tags {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 1.25rem;
      }

      .tag {
        font-size: 0.72rem;
        color: var(--muted);
        border: 1px solid var(--rule);
        padding: 0.12rem 0.55rem;
        border-radius: 999px;
        letter-spacing: 0.01em;
      }

      .links {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
      }

      .links a {
        text-decoration: none;
        font-weight: 550;
        font-size: 0.97rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        border-bottom: 1px solid transparent;
        transition: border-color 0.15s ease;
      }

      .links a:hover {
        border-bottom-color: var(--fg);
      }

      .arrow {
        color: var(--faint);
        font-size: 0.85em;
        transition: transform 0.15s ease;
      }

      .links a:hover .arrow {
        transform: translate(1px, -1px);
      }

      .foot {
        margin-top: clamp(3rem, 8vh, 5rem);
        padding-top: 1.75rem;
        border-top: 1px solid var(--rule);
        color: var(--faint);
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
      }

      .foot a {
        color: var(--muted);
        text-decoration: none;
      }

      .foot a:hover {
        color: var(--fg);
      }

      .dot {
        color: var(--rule);
      }
    </style>
  </body>
</html>
