---
import Content from '../../layouts/Content.astro'
import { getPosts, resolveAuthors, byline, formatDate, isoDate } from '../../lib/content'

const posts = await getPosts()

// Resolve bylines up front: `resolveAuthors` is async and Astro templates cannot
// await inside a map.
const items = await Promise.all(
  posts.map(async (post) => ({
    post,
    authors: await resolveAuthors(post.data.authors),
  })),
)
---

<Content
  title="Blog — rxova"
  description="Essays and design rationale from the rxova projects — the why behind the decisions."
  path="/blog"
>
  <header class="head">
    <h1>Blog</h1>
    <p class="lede">
      Design rationale, things that broke, and why the obvious approach was not the one taken. For
      what actually changed, see the <a href="/changelog">changelog</a>.
    </p>
  </header>

  {items.length === 0 && <p class="empty">Nothing published yet.</p>}

  <ul class="posts">
    {
      items.map(({ post, authors }) => (
        <li class="post">
          <a class="title" href={`/blog/${post.id}`}>
            {post.data.title}
            {post.data.draft && <span class="draft">Draft</span>}
          </a>
          <p class="meta">
            <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
            <span class="dot" aria-hidden="true">
              ·
            </span>
            {byline(authors.map((a) => a.name))}
          </p>
          <p class="desc">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</Content>

<style>
  .head {
    margin-bottom: clamp(2rem, 6vh, 3rem);
  }
  .head h1 {
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    letter-spacing: -0.02em;
    font-weight: 660;
    margin-bottom: 0.6rem;
  }
  .lede {
    color: var(--muted);
    max-width: 46ch;
  }
  .lede a {
    color: var(--fg);
  }
  .empty {
    color: var(--faint);
  }

  .posts {
    list-style: none;
    display: grid;
    gap: 2rem;
  }
  .post .title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--fg);
    text-decoration: none;
    font-size: 1.2rem;
    font-weight: 640;
    letter-spacing: -0.01em;
  }
  .post .title:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* Only ever rendered by `pnpm dev` — drafts are filtered out of the production
     build — but it is the difference between previewing a draft and thinking you
     published one. */
  .draft {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--faint);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
  }
  .meta {
    color: var(--faint);
    font-size: 0.9rem;
    margin: 0.35rem 0 0.5rem;
  }
  .dot {
    color: var(--rule);
    margin: 0 0.4rem;
  }
  .desc {
    color: var(--muted);
    max-width: 62ch;
  }
</style>
