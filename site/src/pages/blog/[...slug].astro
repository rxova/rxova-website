---
import { render } from 'astro:content'
import { Image } from 'astro:assets'

import Content from '../../layouts/Content.astro'
import { getPosts, resolveAuthors, byline, formatDate, isoDate } from '../../lib/content'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content: Body } = await render(post)
const authors = await resolveAuthors(post.data.authors)
---

<Content
  title={`${post.data.title} — rxova`}
  description={post.data.description}
  path={`/blog/${post.id}`}
  ogType="article"
>
  <article>
    <header class="head">
      <a class="back" href="/blog">← Blog</a>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
        <span class="dot" aria-hidden="true">·</span>
        {byline(authors.map((a) => a.name))}
        {
          post.data.updatedDate && (
            <>
              <span class="dot" aria-hidden="true">
                ·
              </span>
              <span>
                updated{' '}
                <time datetime={isoDate(post.data.updatedDate)}>
                  {formatDate(post.data.updatedDate)}
                </time>
              </span>
            </>
          )
        }
      </p>
      {
        post.data.cover && (
          <Image
            class="cover"
            src={post.data.cover}
            alt=""
            widths={[640, 960, 1280]}
            loading="eager"
          />
        )
      }
    </header>

    <div class="prose"><Body /></div>
  </article>
</Content>

<style>
  .head {
    margin-bottom: 2.5rem;
  }
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .back:hover {
    color: var(--fg);
  }
  .head h1 {
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    letter-spacing: -0.02em;
    font-weight: 660;
    line-height: 1.2;
    margin-bottom: 0.6rem;
  }
  .meta {
    color: var(--faint);
    font-size: 0.9rem;
  }
  .dot {
    color: var(--rule);
    margin: 0 0.4rem;
  }
  .cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--rule);
    margin-top: 1.75rem;
  }
  article :global(.prose) {
    max-width: 68ch;
  }
</style>
