{
  "name": "rxova-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "description": "Landing page for rxova open-source projects + docs aggregator for rxova.org",
  "scripts": {
    "dev": "pnpm -C site dev",
    "build": "pnpm -C site build",
    "preview": "pnpm -C site preview",
    "typecheck": "pnpm -C site check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assemble": "node scripts/assemble.mjs",
    "prepare": "husky",
    "sync:og": "node scripts/sync-brand-og.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^1.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "*.{ts,tsx,astro,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,css,md,mdx,yaml,yml}": "prettier --write"
  }
}
