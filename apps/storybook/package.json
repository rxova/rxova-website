{
  "name": "@rxova/storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Storybook for @rxova/astro-ui: every component, its states and its props, with controls.",
  "scripts": {
    "dev": "storybook dev --port 6006 --no-open",
    "build": "storybook build --output-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rxova/astro-ui": "workspace:*",
    "@rxova/brand": "workspace:*",
    "@storybook-astro/framework": "^1.13.0",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/builder-vite": "^10.6.3",
    "@types/node": "^26.6.5",
    "astro": "^7.4.2",
    "storybook": "^10.6.3",
    "typescript": "6.0.3"
  }
}
