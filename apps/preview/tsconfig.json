{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    // @rxova/brand ships uncompiled TypeScript whose relative imports carry a real .ts
    // extension, so typechecking it needs this.
    "allowImportingTsExtensions": true
  }
}
