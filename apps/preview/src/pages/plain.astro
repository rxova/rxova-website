---
/**
 * The non-Starlight surface.
 *
 * `astro.css` is the entry point the rxova.org landing uses, and it is a
 * different stylesheet from `starlight.css` — reset, base element styling, and
 * the short `--bg`/`--fg`/`--rule` aliases the landing was written against. A
 * Starlight route exercises none of that, so it gets its own page here.
 *
 * SiteFooter renders here now: its styles moved out of starlight.css into
 * footer.css, which astro.css imports too, so the plain surfaces get the same
 * footer as the docs sites. This page is where a change to it shows up
 * unstyled if that import is ever lost.
 *
 * Still not rendering ProjectSwitcher: `.rx-switcher__*` is Starlight-only and
 * would render unstyled here. That gap is left visible rather than papered
 * over with local CSS.
 */
import '@rxova/brand/fonts.css'
import '@rxova/brand/astro.css'
import SiteFooter from '@rxova/brand/components/SiteFooter.astro'
import { PROJECTS, RXOVA_ORIGIN } from '@rxova/brand'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Plain Astro surface — rxova brand</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <p class="eyebrow">astro.css</p>
      <h1>The plain Astro surface</h1>
      <p>
        Body copy at the landing's own size and measure, with the reset, base element styling and
        the short token aliases applied. <a href="/">Back to the docs preview</a> — clicking between
        the two is the fastest way to confirm the fonts do not flash across a document navigation,
        because the two surfaces load different stylesheets.
      </p>

      <h2>Type ramp</h2>
      <h3>Heading three</h3>
      <p>
        Inline <code>code</code>, a <a href={RXOVA_ORIGIN}>link to the umbrella origin</a>,{' '}
        <strong>bold</strong> and <em>italic</em>. Tab to the links: the focus ring is{' '}
        <code>--accent</code>, which this stylesheet deliberately aliases to the foreground rather
        than the brand violet.
      </p>

      <h2>Projects</h2>
      <p>
        Read from the same <code>PROJECTS</code> export the landing and the footer use.
      </p>
      <ul>
        {PROJECTS.map((project) => (
          <li>
            <strong>{project.label}</strong> — {project.tagline}
          </li>
        ))}
      </ul>

      <div class="rule"></div>
      <p class="muted">
        The rule above is <code>--rx-gradient</code>; this line is <code>--muted</code>.
      </p>
    </main>
    <div class="footer-measure">
      <SiteFooter />
    </div>
  </body>
</html>

<style>
  main {
    max-width: var(--max);
    margin: 0 auto;
    padding: 4rem 1.5rem;
    display: grid;
    gap: 1rem;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h2 {
    margin-top: 1.5rem;
  }

  ul {
    padding-left: 1.25rem;
    display: grid;
    gap: 0.35rem;
  }

  .rule {
    height: 2px;
    background: var(--rx-gradient);
    margin-top: 2rem;
  }

  .muted {
    color: var(--muted);
  }

  /* The footer brings its own styles; the page only sets its measure. */
  .footer-measure {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
</style>
