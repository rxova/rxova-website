---
import { siteUrl, canonicalUrl } from '@rxova/brand'

import Content from '@rxova/astro-ui/components/SiteShell.astro'
import PageHeader from '@rxova/astro-ui/components/PageHeader.astro'
import ShowMore from '@rxova/astro-ui/components/ShowMore.astro'
import VisuallyHidden from '@rxova/astro-ui/components/VisuallyHidden.astro'
import { getPosts, resolveAuthors, byline, formatDate, isoDate, href } from '../lib/content'
import { excerpt } from '@rxova/astro-ui/lib/entries'

/** How many posts before the index starts batching; a card is shorter than a full update entry. */
const PAGE_SIZE = 10

/** About two to three lines of a card; real text, so "Read more" can follow the ellipsis inline. */
const EXCERPT_CHARS = 200

const updatesUrl = siteUrl('/updates')

const posts = await getPosts()

// Resolve bylines up front: `resolveAuthors` is async and Astro templates cannot
// await inside a map.
const items = await Promise.all(
  posts.map(async (post) => ({
    post,
    authors: await resolveAuthors(post.data.authors),
    // The post's opening, not `description`, which is written for search results
    // and social cards.
    lead: excerpt(post.body ?? '', EXCERPT_CHARS),
  })),
)

const feedUrl = `${canonicalUrl('/blog')}rss.xml`

/**
 * The index as a `Blog`, with its posts as `BlogPosting`s, so a crawler sees dated
 * articles by named authors before fetching any of them.
 */
const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Rxova Blog',
  url: canonicalUrl('/blog'),
  description:
    'Essays and design rationale from the Rxova projects — the why behind the decisions.',
  inLanguage: 'en',
  blogPost: items.map(({ post, authors }) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    url: canonicalUrl(`/blog/${post.id}`),
    datePublished: isoDate(post.data.pubDate),
    ...(post.data.updatedDate && { dateModified: isoDate(post.data.updatedDate) }),
    author: authors.map((a) => ({
      '@type': 'Person',
      name: a.name,
      ...(a.url && { url: a.url }),
    })),
    ...(post.data.tags.length > 0 && { keywords: post.data.tags.join(', ') }),
  })),
}
---

<Content
  title="Blog — Rxova"
  description="Essays and design rationale from the Rxova projects — the why behind the decisions."
  path="/blog"
  feed={{ href: feedUrl, title: 'Rxova Blog' }}
  jsonLd={blogJsonLd}
>
  <PageHeader title="Blog" measure="narrow">
    Design rationale, things that broke, and why the obvious approach was not the one taken. For
    what actually changed, see the <a href={updatesUrl}>updates</a>.
  </PageHeader>

  {items.length === 0 && <p class="empty">Nothing published yet.</p>}

  <ul class="posts" data-reveal-list data-reveal-step={PAGE_SIZE}>
    {items.map(({ post, authors, lead }) => (
      <li class="post">
        <a class="title" href={href(post.id)}>
          {post.data.title}
          {post.data.draft && <span class="draft">Draft</span>}
        </a>
        <p class="meta">
          <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
          <span class="dot" aria-hidden="true">
            ·
          </span>
          {byline(authors.map((a) => a.name))}
        </p>
        <p class="desc">
          {lead.text}
          {lead.truncated && '…'}{' '}
          <a class="more" href={href(post.id)}>
            Read more<VisuallyHidden> of “{post.data.title}”</VisuallyHidden>
            <span aria-hidden="true"> →</span>
          </a>
        </p>
      </li>
    ))}
  </ul>

  <ShowMore noun="posts" />
</Content>

<script>
  import { enhanceShowMore } from '@rxova/astro-ui/scripts/show-more'

  enhanceShowMore()
</script>

<style>
  .empty {
    color: var(--rx-faint);
  }

  .posts {
    list-style: none;
    display: grid;
    gap: 2rem;
  }
  /* Batched away by ShowMore. Explicit rather than left to the UA rule, because a
     grid item is a layout participant and this has to take it out of the flow. */
  .post[hidden] {
    display: none;
  }
  /* ShowMore focuses the first post of a new batch to announce the reveal; it is a
     scroll target, not something the reader tabbed to. */
  .post:focus {
    outline: none;
  }
  .post .title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--rx-fg);
    text-decoration: none;
    font-size: 1.2rem;
    font-weight: 640;
    letter-spacing: -0.01em;
  }
  .post .title:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* Only rendered by `pnpm dev`: drafts are filtered out of the production build. */
  .draft {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--rx-faint);
    border: 1px solid var(--rx-rule);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
  }
  .meta {
    color: var(--rx-faint);
    font-size: 0.9rem;
    margin: 0.35rem 0 0.5rem;
  }
  .dot {
    color: var(--rx-rule);
    margin: 0 0.4rem;
  }
  .more {
    color: var(--rx-fg);
    text-decoration: none;
    border-bottom: 1px solid var(--rx-rule);
    white-space: nowrap;
  }

  .more:hover {
    border-bottom-color: var(--rx-fg);
  }

  .desc {
    color: var(--rx-muted);
    max-width: 62ch;
  }
</style>
