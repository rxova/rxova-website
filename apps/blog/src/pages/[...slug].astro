---
import { render } from 'astro:content'
import { Image } from 'astro:assets'

import { canonicalUrl, siteUrl } from '@rxova/brand'

import BackLink from '@rxova/astro-ui/components/BackLink.astro'
import Content from '@rxova/astro-ui/components/SiteShell.astro'
import { getPosts, resolveAuthors, byline, formatDate, isoDate, href } from '../lib/content'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content: Body } = await render(post)
const authors = await resolveAuthors(post.data.authors)

const url = canonicalUrl(`/blog/${post.id}`)
const feedUrl = `${canonicalUrl('/blog')}rss.xml`

/**
 * A post with a cover shares its cover; everything else shares the umbrella card.
 *
 * `cover.src` is the processed asset's path, already base-prefixed by Astro, so
 * it only needs the origin. Deliberately not the raw source file: the built asset
 * is the one that exists at that URL.
 *
 * No per-post generated card yet — that would mean running satori inside this
 * build. The cover is the honest version of the same idea for the posts that
 * have one, and it costs nothing.
 */
const ogImage = post.data.cover ? siteUrl(post.data.cover.src) : undefined

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  datePublished: isoDate(post.data.pubDate),
  ...(post.data.updatedDate && { dateModified: isoDate(post.data.updatedDate) }),
  author: authors.map((a) => ({
    '@type': 'Person',
    name: a.name,
    ...(a.url && { url: a.url }),
  })),
  ...(ogImage && { image: ogImage }),
  ...(post.data.tags.length > 0 && { keywords: post.data.tags.join(', ') }),
  inLanguage: 'en',
  isPartOf: { '@type': 'Blog', name: 'Rxova Blog', url: canonicalUrl('/blog') },
}
---

<Content
  title={`${post.data.title} — Rxova`}
  description={post.data.description}
  path={`/blog/${post.id}`}
  ogType="article"
  image={ogImage}
  feed={{ href: feedUrl, title: 'Rxova Blog' }}
  jsonLd={jsonLd}
>
  <article>
    <header class="head">
      <BackLink class="back" href={href()}>
        Blog
      </BackLink>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
        <span class="dot" aria-hidden="true">
          ·
        </span>
        {byline(authors.map((a) => a.name))}
        {post.data.updatedDate && (
          <>
            <span class="dot" aria-hidden="true">
              ·
            </span>
            <span>
              updated{' '}
              <time datetime={isoDate(post.data.updatedDate)}>
                {formatDate(post.data.updatedDate)}
              </time>
            </span>
          </>
        )}
      </p>
      {post.data.cover && (
        <Image
          class="cover"
          src={post.data.cover}
          alt={post.data.coverAlt ?? ''}
          widths={[640, 960, 1280]}
          sizes="(min-width: 44rem) 44rem, 100vw"
          loading="eager"
        />
      )}
    </header>

    <div class="prose">
      <Body />
    </div>
  </article>
</Content>

<style>
  .head {
    margin-bottom: 2.5rem;
  }
  .back {
    margin-bottom: 1.5rem;
  }
  .head h1 {
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    letter-spacing: -0.02em;
    font-weight: 660;
    line-height: 1.2;
    margin-bottom: 0.6rem;
  }
  .meta {
    color: var(--rx-faint);
    font-size: 0.9rem;
  }
  .dot {
    color: var(--rx-rule);
    margin: 0 0.4rem;
  }
  .cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--rx-rule);
    margin-top: 1.75rem;
  }
  article :global(.prose) {
    max-width: 68ch;
  }
</style>
