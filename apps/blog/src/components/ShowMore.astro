---
/**
 * Reveals a long list a batch at a time.
 *
 * Drives whatever element carries `data-reveal-list`, using its direct element
 * children as the items and `data-reveal-step` as the batch size. Config lives in
 * the markup rather than in props because an Astro `<script>` is bundled once for
 * the page, not instantiated per component — the DOM is where the two halves meet.
 *
 * The control ships `hidden` and the script un-hides it, so without JS every item
 * is on the page exactly as it was before this existed. That also means find-in-page
 * misses whatever is batched away, which is what "Show all" is for.
 *
 * The updates stream has its own copy of this rather than importing it: there the
 * limit is one variable in a filter state machine, and the two only look alike from
 * a distance.
 */
---

<div class="more" data-reveal-controls hidden>
  <button class="more-btn" type="button" data-reveal-more>
    Show more<span class="visually-hidden"> posts</span>
  </button>
  <button class="show-all" type="button" data-reveal-all>
    Show all
  </button>
  <p class="progress" data-reveal-progress></p>
</div>

<style>
  .more {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  /* `display: flex` above outranks the UA's `[hidden] { display: none }`, so the
     attribute alone would leave the control on screen with nothing left to reveal —
     including on the initial render, before the script has run. */
  .more[hidden] {
    display: none;
  }
  .more-btn {
    font: inherit;
    font-size: 0.9rem;
    color: var(--fg);
    background: var(--tag-bg);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.35rem 1rem;
    cursor: pointer;
  }
  .more-btn:hover {
    border-color: var(--accent);
  }
  .show-all {
    font: inherit;
    font-size: 0.85rem;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .show-all:hover {
    color: var(--fg);
  }
  .more-btn:focus-visible,
  .show-all:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .progress {
    margin-left: auto;
    color: var(--faint);
    font-size: 0.85rem;
  }
  /* Not display:none — a screen reader has to reach it. Keeps "Show more" from
     being the whole accessible name. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media print {
    .more {
      display: none;
    }
  }
</style>

<script>
  import { nextLimit } from '@rxova/astro-ui/lib/entries'
  ;(function () {
    const found = {
      list: document.querySelector<HTMLElement>('[data-reveal-list]'),
      controls: document.querySelector<HTMLElement>('[data-reveal-controls]'),
    }
    if (!found.list || !found.controls) return
    const list: HTMLElement = found.list
    const controls: HTMLElement = found.controls

    const items = Array.from(list.children) as HTMLElement[]
    const moreBtn = controls.querySelector<HTMLElement>('[data-reveal-more]')
    const allBtn = controls.querySelector<HTMLElement>('[data-reveal-all]')
    const progress = controls.querySelector<HTMLElement>('[data-reveal-progress]')

    const step = Number(list.dataset.revealStep) || items.length
    let limit = step

    function apply() {
      items.forEach((el, i) => {
        el.hidden = i >= limit
      })
      controls.hidden = limit >= items.length
      if (progress) {
        progress.textContent = limit < items.length ? `Showing ${limit} of ${items.length}` : ''
      }
    }

    /** Raise the limit, then put the reader at the first item that appeared. */
    function reveal(next: number) {
      const first = items[limit]
      limit = next
      apply()
      if (!first) return
      // preventScroll because the new batch begins exactly where the button was:
      // the viewport is already in the right place, and scrolling would move it.
      first.tabIndex = -1
      first.focus({ preventScroll: true })
    }

    moreBtn?.addEventListener('click', () => reveal(nextLimit(limit, step, items.length)))
    // Also the way out of find-in-page missing what is batched away.
    allBtn?.addEventListener('click', () => reveal(items.length))

    apply()
  })()
</script>
