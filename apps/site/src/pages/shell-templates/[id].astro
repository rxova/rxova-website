---
import sources from '../../../../../sources.json'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { shellFor, type ShellSource } from '../../lib/shell'

export function getStaticPaths() {
  return (sources.sources as ShellSource[])
    .filter((source) => source.enabled === true)
    .map((source) => ({ params: { id: source.id }, props: { source } }))
}

const { source } = Astro.props as { source: ShellSource }
const { path, project } = shellFor(source)
---

<BaseLayout
  title={`Rxova page shell — ${source.id}`}
  path={path}
  project={project}
  robots="noindex"
  template
/>
