---
/**
 * /about: who maintains rxova, why it exists, and what the projects are held to, told mostly in
 * pictures. The copy is ../lib/about.ts, shared with the landing.
 */
import { siteUrl } from '@rxova/brand'
import AboutIntro from '../components/about/AboutIntro.astro'
import AboutPrinciples from '../components/about/AboutPrinciples.astro'
import Contributing from '../components/about/Contributing.astro'
import Maintenance from '../components/about/Maintenance.astro'
import Origins from '../components/about/Origins.astro'
import { MAINTAINER } from '../lib/about'
import BaseLayout from '../layouts/BaseLayout.astro'
// See ../layouts/BaseLayout.astro for why the reset is imported per page rather than
// by BaseLayout.
import '../styles/global.css'

const description = `Rxova is built and maintained by ${MAINTAINER.name} — small TypeScript libraries for the hard parts of the browser, with stable APIs, thorough tests, and documentation that answers the question you arrived with.`
---

<BaseLayout title="About — Rxova" path="/about">
  <Fragment slot="head">
    <meta name="description" content={description} />
    <meta property="og:title" content="About Rxova" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={siteUrl('/about')} />
    <meta property="og:image" content={siteUrl('/og/rxova.png')} />
    <meta name="twitter:card" content="summary_large_image" />
  </Fragment>
  <main>
    <AboutIntro />
    <div class="gradient-rule" aria-hidden="true"></div>
    <Origins />
    <AboutPrinciples />
    <Maintenance />
    <Contributing />
  </main>

  <style>
    main {
      max-width: var(--rx-max-wide);
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .gradient-rule {
      height: 2px;
      border-radius: var(--rx-radius-pill);
      background: var(--rx-gradient);
    }
  </style>
</BaseLayout>
