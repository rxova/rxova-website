---
/**
 * One repo's slice of the updates feed, prerendered so crawlers, no-JS visitors and docs sites get a URL.
 * Every repo in REPOS gets a page, even with no entries yet, so a docs link never 404s.
 */
import { render } from "astro:content";

import { siteUrl, canonicalUrl } from "@rxova/brand";

import PageHeader from "@rxova/astro-ui/components/PageHeader.astro";
import Content from "../../../layouts/Page.astro";
import UpdatesStream from "../../../components/updates/UpdatesStream.astro";
import type { StreamItem } from "../../../components/updates/stream/Entry.astro";
import { getUpdates, resolveAuthors, REPOS, href } from "../../../lib/updates";

export async function getStaticPaths() {
  const entries = await getUpdates();
  return REPOS.map((repo) => ({
    params: { id: repo.id },
    props: {
      repo,
      entries: entries.filter((e) => (e.data.repos as string[]).includes(repo.id)),
    },
  }));
}

const { repo, entries } = Astro.props;

// A project repo shares its own card rather than the umbrella one; infrastructure
// repos have no card.
const ogImage = repo.project ? siteUrl(`/og/${repo.id}.png`) : undefined;
const feedUrl = `${canonicalUrl("/updates")}rss.xml`;

/** Where this repo's reader is sent: its GitHub URL, or the app's own page when the
 * source is private. See REPOS in @rxova/brand. */
const source =
  "repo" in repo
    ? { href: repo.repo, label: "the repository ↗", tail: "for commits and releases.", out: true }
    : { href: repo.page, label: "the app's page", tail: "for what it does.", out: false };

const items: StreamItem[] = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Body: (await render(entry)).Content,
    authorNames: (await resolveAuthors(entry.data.authors)).map((a) => a.name),
  })),
);
---

<Content
  title={`${repo.label} updates — Rxova`}
  description={`What is moving in ${repo.label} — releases, fixes and infrastructure.`}
  path={`/updates/repos/${repo.id}`}
  image={ogImage}
  feed={{ href: feedUrl, title: "Rxova Updates" }}
>
  <PageHeader title={repo.label} back={{ href: href(), label: "All repos" }} variant="detail">
    Updates mentioning {repo.label}. See{" "}
    <a
      href={source.href}
      target={source.out ? "_blank" : undefined}
      rel={source.out ? "noopener noreferrer" : undefined}
    >
      {source.label}
    </a>{" "}
    {source.tail}
  </PageHeader>

  {items.length === 0 ? (
    <p class="empty">No updates for {repo.label} yet.</p>
  ) : (
    <UpdatesStream items={items} activeRepo={repo.id} />
  )}
</Content>

<style>
  .empty {
    color: var(--rx-faint);
  }
</style>
