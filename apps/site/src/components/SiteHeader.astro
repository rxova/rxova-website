---
/**
 * The landing's adapter onto @rxova/astro-ui's shared `Header`, supplying only the menu:
 * derived from what is deployed (Projects + `navSurfaces`), with root-relative links.
 */
import Header from '@rxova/astro-ui/components/Header.astro'
import { navSurfaces } from '../lib/projects'

interface Props {
  /** Current path, so the active item can be marked. */
  path: string
}

const { path } = Astro.props

// Projects first, then mounted surfaces that have shipped (see `navSurfaces`).
const surfaces = [{ label: 'Projects', href: '/' }, ...navSurfaces]

/** `/` matches only itself; everything else its subtree. Pages pass `/blog` or `/blog/x`. */
const here = path.endsWith('/') ? path : `${path}/`
const isCurrent = (href: string) => (href === '/' ? here === '/' : here.startsWith(href))

const items = surfaces.map((s) => ({ label: s.label, href: s.href, current: isCurrent(s.href) }))
---

<Header homeHref="/" logoSrc="/rxova-logo-256.png" items={items} />
