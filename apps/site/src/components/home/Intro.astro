---
/** /projects' opening: what the projects have in common, then straight to them. */
import { landingProjects, projectListSentence } from "../../lib/projects";
---

<header class="intro">
  <p class="kicker rise">Projects</p>
  <h1 class="rise" style="--d: 60ms">
    Take one package, keep the rest of your stack.
  </h1>
  <p class="lede rise" style="--d: 120ms">
    {landingProjects.length} independent TypeScript libraries, one problem each:{" "}
    {projectListSentence}. Each installs on its own, with its docs and a walkthrough below.
  </p>
</header>

<style>
  .intro {
    padding-block: clamp(3rem, 9vh, 5.5rem) clamp(2rem, 5vh, 3rem);
  }
  .kicker {
    font-family: var(--rx-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rx-faint);
    margin-bottom: 1rem;
  }
  /* The same display size as the landing's title, so the two pages open alike. */
  .intro h1 {
    max-width: 18ch;
    font-size: clamp(2.2rem, 5.2vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 650;
    text-wrap: balance;
  }
  .lede {
    margin-top: 1.25rem;
    max-width: 40rem;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: var(--rx-muted);
    text-wrap: pretty;
  }
  /* The load animation: pure CSS that ends at rest, so it always completes. */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .rise {
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .rise {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
