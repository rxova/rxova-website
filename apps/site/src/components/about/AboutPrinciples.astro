---
/** The four rules as numbered cards, each with a small picture; ids are the landing's anchors. */
import CopyButton from "@rxova/astro-ui/components/CopyButton.astro";
import { PRINCIPLES } from "../../lib/about";
import { STANDARD_ICONS } from "../../lib/home";
import Eyebrow from "../home/Eyebrow.astro";
import Reveal from "../home/Reveal.astro";
import SectionHeading from "../home/SectionHeading.astro";
---

<section class="band" aria-labelledby="principles">
  <Reveal class="head">
    <Eyebrow>What the projects share</Eyebrow>
    <SectionHeading id="principles">Four rules you can check against the code.</SectionHeading>
  </Reveal>

  <ol class="rules">
    {PRINCIPLES.map((p, i) => (
      <Reveal as="li" class="rule" id={p.id} style={`--d: ${i * 70}ms`}>
        <div class="rule-top">
          <svg
            class="rule-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={STANDARD_ICONS[p.icon]}
          />
          <span class="rule-number" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
        </div>
        <h3 class="rule-title">{p.card.title}</h3>
        {p.card.visual?.kind === "packages" && (
          <p class="packages">
            <span class="core">{p.card.visual.core}</span>
            <svg class="to" viewBox="0 0 28 12" fill="none" aria-hidden="true">
              <path d="M0 6h26M21 1l5 5-5 5" />
            </svg>
            <span class="sr-only">then</span>
            <span class="bindings">{p.card.visual.bindings}</span>
          </p>
        )}
        {p.card.visual?.kind === "tags" && (
          <ul class="tags">
            {p.card.visual.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )}
        {p.card.visual?.kind === "command" && (
          <div class="command">
            <span class="prompt" aria-hidden="true">
              $
            </span>
            <code>{p.card.visual.command}</code>
            <CopyButton text={p.card.visual.command} label="Copy the install command" />
          </div>
        )}
        <p class="rule-line">{p.card.line}</p>
      </Reveal>
    ))}
  </ol>
</section>

<style>
  /* Set off by hairlines, not a fill: a full-bleed --rx-card reads as a brown slab in dark. */
  .band {
    padding-block: clamp(3rem, 9vh, 5.5rem);
    border-block: 1px solid var(--rx-rule);
  }

  .head {
    margin-bottom: 2.25rem;
  }

  .rules {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .rule {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.4rem, 2.6vw, 2rem);
    border: 1px solid var(--rx-rule);
    border-radius: calc(var(--rx-radius) + 4px);
    background: var(--rx-bg);
    /* The header is sticky; an anchor jump must not land underneath it. */
    scroll-margin-top: 5rem;
  }

  .rule-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .rule-icon {
    width: 2rem;
    height: 2rem;
    color: var(--rx-primary);
  }

  .rule-number {
    font-family: var(--rx-font-mono);
    font-size: 0.85rem;
    color: var(--rx-muted);
  }

  .rule-title {
    font-size: 1.3rem;
    font-weight: 620;
    letter-spacing: -0.01em;
  }

  .rule-line {
    color: var(--rx-muted);
  }

  .packages {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--rx-font-mono);
    font-size: 0.85rem;
  }

  .core,
  .bindings {
    padding: 0.45rem 0.75rem;
    border-radius: 8px;
  }

  .core {
    background: var(--rx-tag-bg);
  }

  .bindings {
    border: 1px solid var(--rx-rule-strong);
  }

  .to {
    width: 1.75rem;
    height: 0.75rem;
    stroke: var(--rx-faint);
    stroke-width: 1.5;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tags li {
    padding: 0.35rem 0.75rem;
    border-radius: var(--rx-radius-pill);
    background: var(--rx-tag-bg);
    font-family: var(--rx-font-mono);
    font-size: 0.8rem;
  }

  .command {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding-inline: 0.9rem 0.45rem;
    border: 1px solid var(--rx-rule);
    border-radius: 8px;
    /* A terminal in both themes, so it does not invert into a light bar on the dark page. */
    background: #14140f;
    color: #f4f1ea;
    font-family: var(--rx-font-mono);
    font-size: 0.85rem;
  }

  /* The command scrolls on its own when narrow, so the copy button never scrolls out of reach. */
  .command code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
  }

  .prompt {
    opacity: 0.6;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 52rem) {
    .rules {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
