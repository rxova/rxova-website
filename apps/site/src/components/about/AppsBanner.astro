---
/** The landing's one plug for the store: the shipped apps, above the packages that fill the
 * rest of the page. Reads ../../lib/apps, so a new app appears here without an edit. */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { APPS } from "../../lib/apps";
import { screenshots } from "../../lib/nx-link";
import Eyebrow from "../home/Eyebrow.astro";
import Reveal from "../home/Reveal.astro";

/** One captured screen per app; an app with none renders as copy alone. */
const SHOTS: Record<string, ImageMetadata | undefined> = { "nx-link": screenshots[0]?.src };
---

<section class="band" aria-labelledby="apps-banner">
  <Reveal class="head">
    <Eyebrow id="apps-banner">Apps</Eyebrow>
  </Reveal>

  <ul class="apps">
    {APPS.map((app) => (
      <Reveal as="li" class="app">
        <div class="app__copy">
          <p class="app__platform">{app.platform}</p>
          <h3 class="app__name">
            <a href={app.href}>{app.label}</a>
          </h3>
          <p class="app__tagline">{app.tagline}</p>
          <ul class="facts">
            {app.facts.map((fact) => (
              <li class="fact">{fact}</li>
            ))}
          </ul>
          <div class="app__actions">
            {app.store && (
              <a class="cta cta--primary" href={app.store.href}>
                {app.store.label}
              </a>
            )}
            <a class="cta" href={app.href}>
              What it does
            </a>
          </div>
        </div>
        {SHOTS[app.id] && (
          <a class="app__shot" href={app.href} tabindex="-1" aria-hidden="true">
            <Image src={SHOTS[app.id]!} alt="" loading="lazy" widths={[220, 440]} />
          </a>
        )}
      </Reveal>
    ))}
  </ul>
</section>

<style>
  .band {
    padding-block: clamp(3rem, 9vh, 5.5rem);
  }

  .apps {
    list-style: none;
    display: grid;
    gap: 1.25rem;
    padding: 0;
    margin: 0;
  }

  .app {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: 1.75rem;
    border: 1px solid var(--rx-rule);
    border-radius: calc(var(--rx-radius) + 4px);
    background: var(--rx-card, var(--rx-bg));
  }

  .app__copy {
    display: grid;
    gap: 0.75rem;
  }

  .app__platform {
    font-family: var(--rx-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rx-faint);
  }

  .app__name {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .app__name a {
    color: inherit;
    text-decoration: none;
  }

  .app__name a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .app__tagline {
    color: var(--rx-muted);
    max-width: 46ch;
  }

  .facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
  }

  .fact {
    font-family: var(--rx-font-mono);
    font-size: 0.72rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--rx-rule);
    border-radius: var(--rx-radius-pill);
    color: var(--rx-muted);
  }

  .app__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--rx-rule);
    border-radius: var(--rx-radius-pill);
    font-weight: 500;
    text-decoration: none;
    color: var(--rx-fg);
    transition: border-color 0.15s ease;
  }

  .cta:hover {
    border-color: var(--rx-fg);
  }

  .cta--primary {
    background: var(--rx-gradient);
    border-color: transparent;
    color: #fff;
  }

  /* Decoration beside copy that already says everything: out of the reading order,
     and gone entirely where there is no room for it. */
  .app__shot img {
    width: 100%;
    height: auto;
    border: 1px solid var(--rx-rule);
    border-radius: 12px;
  }

  @media (max-width: 52rem) {
    .app {
      grid-template-columns: minmax(0, 1fr);
    }
    .app__shot {
      display: none;
    }
  }
</style>
