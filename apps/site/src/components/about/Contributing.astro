---
/** How to help, smallest first, then where each project's issues and pull requests go. */
import { CONTRIBUTIONS, MAINTAINER, type Contribution } from "../../lib/about";
import { landingProjects } from "../../lib/projects";
import Eyebrow from "../home/Eyebrow.astro";
import Reveal from "../home/Reveal.astro";
import SectionHeading from "../home/SectionHeading.astro";

const ICONS: Record<Contribution["id"], string> = {
  // A bug.
  repro:
    '<path d="M8 6.5V5a4 4 0 0 1 8 0v1.5" /><rect x="6" y="6.5" width="12" height="13" rx="6" /><path d="M12 11v8.5M3 13h3M18 13h3M4 8.5l2.3 1.2M20 8.5l-2.3 1.2M4 19l2.4-1.6M20 19l-2.4-1.6" />',
  // A branch merging back.
  "pull-request":
    '<circle cx="6" cy="5.6" r="2.3" /><circle cx="6" cy="18.4" r="2.3" /><circle cx="18" cy="18.4" r="2.3" /><path d="M6 7.9v8.2M18 16.1V10a3 3 0 0 0-3-3h-4M13 4.5 10.5 7 13 9.5" />',
  // A page.
  docs: '<path d="M6 3.5h8l4 4v13H6z" /><path d="M14 3.5v4h4M9 12h6M9 15.5h6" />',
};
---

<section class="band" aria-labelledby="contributing">
  <Reveal class="head">
    <Eyebrow>Contributing</Eyebrow>
    <SectionHeading id="contributing">The most useful help is small.</SectionHeading>
  </Reveal>

  <ul class="ways">
    {CONTRIBUTIONS.map((c, i) => (
      <Reveal as="li" class="way" style={`--d: ${i * 70}ms`}>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={ICONS[c.id]}
        />
        <h3>{c.title}</h3>
        <p>{c.line}</p>
      </Reveal>
    ))}
  </ul>

  <p class="where">Issues and pull requests go to each project's repo:</p>
  <ul class="repos">
    {landingProjects.map((p) => (
      <li>
        <a href={p.repo} target="_blank" rel="noopener noreferrer">
          <span class="repo-name">{p.label}</span>
          <span class="repo-tagline">{p.tagline}</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="private">
    Security or private: <a href={`mailto:${MAINTAINER.email}`}>{MAINTAINER.email}</a>
  </p>
</section>

<style>
  .band {
    padding-block: clamp(3rem, 9vh, 5.5rem);
    border-top: 1px solid var(--rx-rule);
  }

  .head {
    margin-bottom: 2.25rem;
  }

  .ways {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .way {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.6rem;
    border: 1px solid var(--rx-rule);
    border-radius: calc(var(--rx-radius) + 4px);
    background: var(--rx-bg);
  }

  .way svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .way h3 {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .way p,
  .where,
  .private {
    color: var(--rx-muted);
  }

  .where {
    margin: 2.5rem 0 1rem;
  }

  .repos {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.75rem;
  }

  .repos a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    box-sizing: border-box;
    padding: 1.1rem;
    border: 1px solid var(--rx-rule);
    border-radius: var(--rx-radius);
    background: var(--rx-bg);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .repos a:hover {
    border-color: var(--rx-fg);
  }

  .repo-name {
    font-family: var(--rx-font-mono);
    font-weight: 500;
  }

  .repo-tagline {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--rx-muted);
  }

  .private {
    margin-top: 1.5rem;
  }

  .private a {
    font-family: var(--rx-font-mono);
    color: var(--rx-fg);
    text-underline-offset: 3px;
  }

  @media (max-width: 52rem) {
    .ways {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
