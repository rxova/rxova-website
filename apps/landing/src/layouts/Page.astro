---
/**
 * The layout for the blog and the updates: the site's own document and chrome from
 * `BaseLayout`, plus the metadata and prose styling a content page needs. It replaces the
 * header-less `SiteShell` document those sections were built with while they were separate
 * builds composed into the shell at deploy time.
 */
import { canonicalUrl, siteUrl } from '@rxova/brand'
import BaseLayout from './BaseLayout.astro'
// See ./BaseLayout.astro for why the reset is imported per page rather than by BaseLayout.
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** Canonical path, e.g. `/blog/why-rxova-has-a-blog`. */
  path: string
  ogType?: 'website' | 'article'
  /** Absolute URL of the social card, chosen by the caller; defaults to the umbrella card. */
  image?: string
  /** Advertises an RSS feed for this section, as `rel="alternate"`. */
  feed?: { href: string; title: string }
  /** JSON-LD for this page, emitted verbatim as `application/ld+json`. */
  jsonLd?: unknown
}

const { title, description, path, ogType = 'website', image, feed, jsonLd } = Astro.props

// Normalised, so no caller can declare a URL without the trailing slash (a 301).
const url = canonicalUrl(path)
const ogImage = image ?? siteUrl('/og/rxova.png')

/** Serialise JSON-LD for an inline `<script>`; `<` is escaped so a `</script>` cannot close it. */
const serialiseJsonLd = (value: unknown): string => JSON.stringify(value).replace(/</g, '\\u003c')
---

<BaseLayout title={title} path={path}>
  <Fragment slot="head">
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {feed && (
      <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />
    )}
    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={serialiseJsonLd(jsonLd)}></script>
    )}
  </Fragment>
  <main>
    <slot />
  </main>

  <style>
    main {
      max-width: var(--rx-max-wide);
      margin: 0 auto;
      padding: clamp(2rem, 6vh, 3.5rem) 1.5rem 4rem;
    }
  </style>

  <!-- Prose styling for rendered markdown. Global because <Content /> markup carries no Astro
       scoping attributes. -->
  <style is:global>
    .prose {
      color: var(--rx-muted);
      line-height: 1.7;
    }
    .prose > * + * {
      margin-top: 1.1rem;
    }
    .prose h2 {
      color: var(--rx-fg);
      font-size: 1.25rem;
      font-weight: 640;
      letter-spacing: -0.01em;
      margin-top: 2.5rem;
    }
    .prose h3 {
      color: var(--rx-fg);
      font-size: 1.05rem;
      font-weight: 620;
      margin-top: 2rem;
    }
    .prose a {
      color: var(--rx-fg);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .prose strong {
      color: var(--rx-fg);
      font-weight: 620;
    }
    .prose ul,
    .prose ol {
      margin-left: 1.2rem;
    }
    .prose li + li {
      margin-top: 0.35rem;
    }
    .prose code {
      font-family: var(--rx-font-mono);
      font-size: 0.88em;
      background: var(--rx-tag-bg);
      padding: 0.05rem 0.35rem;
      border-radius: 4px;
    }
    .prose pre {
      background: var(--rx-card);
      border: 1px solid var(--rx-rule);
      border-radius: 10px;
      padding: 1rem 1.1rem;
      /* Long lines scroll inside the block; the page itself never does. */
      overflow-x: auto;
    }
    .prose pre code {
      background: none;
      padding: 0;
    }
    .prose blockquote {
      border-left: 2px solid var(--rx-rule);
      padding-left: 1rem;
      color: var(--rx-faint);
    }
    .prose img {
      max-width: 100%;
      height: auto;
      border-radius: 10px;
    }
    .prose table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.95rem;
    }
    .prose th,
    .prose td {
      border-bottom: 1px solid var(--rx-rule);
      padding: 0.5rem 0.6rem;
      text-align: left;
    }
    .prose th {
      color: var(--rx-fg);
      font-weight: 620;
    }
  </style>
</BaseLayout>
