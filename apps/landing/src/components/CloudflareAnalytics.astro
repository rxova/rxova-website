---
/**
 * Cloudflare Web Analytics, only when the build has a token (production, from a secret).
 * The beacon is cookie-free and reports aggregate page paths and referrers.
 */
const token = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN
const beacon = token ? JSON.stringify({ token }) : undefined
---

{token && (
  <script
    is:inline
    type="module"
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={beacon}
  ></script>
)}
