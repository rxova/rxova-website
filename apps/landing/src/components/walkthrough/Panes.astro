---
/**
 * Both sides of the story, each with its label, its notes and its code, gutter-numbered by note.
 * The tour stacks them in one cell and shows one; without JS they sit one above the other.
 */
import { Code } from 'astro-expressive-code/components'
import { lineMarkers, type Showcase } from '../../lib/walkthrough'

interface Props {
  story: Showcase
  /** Prefixes the ids inside. */
  id: string
}

const { story, id } = Astro.props

// Inline code in a note, without pulling a markdown renderer into a component.
const code = (text: string) =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/`([^`]+)`/g, '<code>$1</code>')

const sides = (['before', 'after'] as const).map((key) => {
  const side = story[key]
  const text = side.code.trimEnd()
  return {
    key,
    label: side.label,
    lang: side.lang,
    code: text,
    notes: story.notes.map((note) => (key === 'before' ? note.problem : note.fix)),
    markers: { [key === 'before' ? 'del' : 'ins']: lineMarkers(text, story.notes, key) },
  }
})
---

<div class="panes">
  {sides.map((side) => (
    <div
      class={`pane ${side.key}`}
      role="group"
      data-pane={side.key}
      aria-labelledby={`${id}-${side.key}-label`}
    >
      <p class={`label ${side.key}`} id={`${id}-${side.key}-label`}>
        {side.label}
      </p>
      <ol class="notes">
        {side.notes.map((note) => (
          <li class="note" data-note>
            <span set:html={code(note)} />
          </li>
        ))}
      </ol>
      <div class="code" data-code>
        <Code code={side.code} lang={side.lang} {...side.markers} />
      </div>
    </div>
  ))}
</div>

<style>
  .panes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .pane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding: 1rem;
  }

  .pane + .pane {
    border-top: 1px solid var(--rx-rule);
  }

  .label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }

  .label.before {
    color: var(--wt-before);
  }

  .label.after {
    color: var(--wt-after);
  }

  .notes {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0 0 0 1.4rem;
    color: var(--rx-muted);
    font-size: 0.9rem;
  }

  .note :global(code) {
    font-family: var(--rx-font-mono);
    font-size: 0.88em;
    padding: 0.05em 0.3em;
    border-radius: 4px;
    background: var(--rx-card);
  }

  .code {
    position: relative;
    min-width: 0;
  }

  .code :global(.expressive-code) {
    margin: 0;
    /* Room for the note numbers in the gutter. */
    --ec-codePadInl: 2.25rem;
  }

  /* The tour, after the rules above so it wins their ties: both sides in one cell, so switching never
     moves the page; the note lists give way to the caption; the code scrolls in a fixed height. */
  :global(.walkthrough[data-js]) .pane {
    grid-area: 1 / 1;
    padding: 0;
    border-top: 0;
    transition:
      opacity 0.35s ease,
      visibility 0.35s;
  }

  :global(.walkthrough[data-js]) .label,
  :global(.walkthrough[data-js]) .notes {
    display: none;
  }

  :global(.walkthrough[data-show='before']) .pane.after,
  :global(.walkthrough[data-show='after']) .pane.before {
    visibility: hidden;
    opacity: 0;
  }

  :global(.walkthrough[data-js]) .code {
    height: min(26rem, 58vh);
    overflow: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding-block: 0.4rem;
  }

  /* Only the note in play keeps its highlight, number and accent. */
  :global(.walkthrough[data-js]) .code :global(.ec-line.part:not(.lit)) {
    background-color: transparent;
  }

  :global(.walkthrough[data-js]) .code :global(.ec-line.part:not(.lit) .code) {
    --ecLineBrdCol: transparent;
  }

  :global(.walkthrough[data-js]) .code :global(.ec-line.part:not(.lit) .code::before) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .code :global(.ec-line.part) {
      transition: background-color 0.4s ease;
    }

    .code :global(.ec-line.part .code::before) {
      transition: opacity 0.4s ease;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.walkthrough[data-js]) .pane {
      transition: none;
    }
  }

  @container (max-width: 36rem) {
    .code :global(.expressive-code) {
      --ec-codePadInl: 1.75rem;
    }
  }

  /* A phone's height, not only its width, decides how much code fits. */
  @media (max-width: 34rem) {
    :global(.walkthrough[data-js]) .code {
      height: min(22rem, 52vh);
    }
  }
</style>
