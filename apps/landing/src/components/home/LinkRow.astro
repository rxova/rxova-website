---
/** A row of links whose underline sweeps in on hover; buttons in the row keep their own look. */
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'nav'> & { label: string }

const { label, class: className, ...rest } = Astro.props
---

<nav class:list={['links', className]} aria-label={label} {...rest}>
  <slot />
</nav>

<style>
  .links {
    display: flex;
    gap: 1.4rem;
    flex-wrap: wrap;
  }
  /* `:not(.btn)`, because the sweep is a background image and a button's fill is too. */
  .links :global(a:not(.btn)) {
    text-decoration: none;
    font-weight: 550;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding-bottom: 2px;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .links :global(a:not(.btn):hover) {
    background-size: 100% 1px;
  }
  @media (prefers-reduced-motion: reduce) {
    .links :global(a) {
      transition: none;
    }
  }
  @media (max-width: 40rem) {
    .links {
      gap: 1.1rem;
    }
  }
</style>
