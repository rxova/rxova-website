---
/** The arrow after a link's label: `across` to a page on this site, `out` to one elsewhere. Drawn, so both match the label. */
interface Props {
  dir: 'across' | 'out'
}

const { dir } = Astro.props

const PATHS = {
  across: '<path d="M3 8h10M9 4l4 4-4 4" />',
  out: '<path d="M4.5 11.5l7-7M5.5 4.5h6v6" />',
}
---

<svg
  class="arrow"
  data-dir={dir}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={PATHS[dir]}
/>

<style>
  .arrow {
    flex: none;
    width: 0.9em;
    height: 0.9em;
    color: currentColor;
    opacity: 0.7;
    transition: transform 0.18s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Each arrow nudges the way it points: across the page, or out of it. */
  :global(.btn:hover) .arrow,
  :global(.links a:hover) .arrow {
    transform: translate(2px, 0);
  }
  :global(.btn:hover) .arrow[data-dir='out'],
  :global(.links a:hover) .arrow[data-dir='out'] {
    transform: translate(2px, -2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .arrow {
      transition: none;
    }
  }
</style>
