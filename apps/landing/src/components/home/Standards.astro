---
/** What the projects are held to, as a band of labelled claims rather than a row of counts. */
import { STANDARDS } from '../../lib/about'
import { STANDARD_ICONS } from '../../lib/home'
---

<section class="standards" aria-label="How these are built">
  <ul class="standard-list">
    {STANDARDS.map((item) => (
      <li class="standard">
        {STANDARD_ICONS[item.id] && (
          <svg
            class="standard-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={STANDARD_ICONS[item.id]}
          />
        )}
        <p class="standard-label">{item.label}</p>
        <p class="standard-detail">{item.detail}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .standards {
    border-block: 1px solid var(--rx-rule);
    padding-block: 2rem;
  }
  .standard-list {
    list-style: none;
    display: grid;
    gap: 1.5rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  /* Icon beside the label, detail hanging under it. */
  .standard {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.7rem;
    row-gap: 0.3rem;
    /* Slack collects at the bottom, so a shorter item's rows do not drift down to match a taller one. */
    align-content: start;
  }
  /* A little larger than the label, in the faint ink, so the row still reads label-first. */
  .standard-icon {
    grid-column: 1;
    grid-row: 1;
    width: 1.375rem;
    height: 1.375rem;
    align-self: center;
    color: var(--rx-faint);
  }
  .standard-label {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--rx-font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rx-fg);
  }
  /* Under the label, not the icon: the indent binds the pair. */
  .standard-detail {
    grid-column: 2;
    grid-row: 2;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--rx-muted);
  }
  @media (max-width: 40rem) {
    .standard-list {
      gap: 1.1rem 1.5rem;
    }
  }
</style>
