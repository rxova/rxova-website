---
/** Starlight `Header` override: adds a phone menu to pages without a sidebar, which Starlight gives
 * none. A `<details>`, so it opens without JavaScript; the script adds Esc and outside-click closing. */
import Default from "@astrojs/starlight/components/Header.astro";
import MenuContent from "./MenuContent.astro";

// Narrowed structurally, as in SiteTitle.astro.
const { hasSidebar } = (Astro.locals as unknown as { starlightRoute: { hasSidebar: boolean } })
  .starlightRoute;
---

<Default>
  <slot />
</Default>
{!hasSidebar && (
  <details class="rx-menu md:sl-hidden print:hidden">
    <summary class="rx-menu__toggle" aria-controls="rx-menu-panel">
      <svg class="rx-menu__open" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
        <path
          d="M4 7h16M4 12h16M4 17h16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
        />
      </svg>
      <svg class="rx-menu__close" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
        <path
          d="M6 6l12 12M18 6L6 18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
        />
      </svg>
      <span class="sr-only">Menu</span>
    </summary>
    <div class="rx-menu__panel" id="rx-menu-panel">
      <MenuContent />
    </div>
  </details>
)}

<script>
  const menu = document.querySelector<HTMLDetailsElement>("details.rx-menu");
  const toggle = menu?.querySelector<HTMLElement>(".rx-menu__toggle");

  if (menu && toggle) {
    const close = (refocus: boolean): void => {
      if (!menu.open) return;
      menu.open = false;
      if (refocus) toggle.focus();
    };

    menu.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !menu.open) return;
      // Leave an open theme picker's own Esc alone.
      if (event.defaultPrevented) return;
      event.preventDefault();
      close(true);
    });
    // Outside a click, or focus moving elsewhere, the menu is no longer what the reader is using.
    document.addEventListener("click", (event) => {
      if (!menu.contains(event.target as Node)) close(false);
    });
    menu.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && !menu.contains(next)) close(false);
    });
    // Wider than a phone the menu is hidden; do not leave it open behind the desktop header.
    matchMedia("(min-width: 50rem)").addEventListener("change", (event) => {
      if (event.matches) close(false);
    });
  }
</script>
