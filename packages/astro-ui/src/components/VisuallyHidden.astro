---
/** Text only screen readers get; unlike `display: none`, it stays in the accessibility tree. */
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'span'>

const { class: className, ...rest } = Astro.props
---

<span class:list={['visually-hidden', className]} {...rest}>
  <slot />
</span>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
