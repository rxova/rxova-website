---
import type { HTMLAttributes } from 'astro/types'

/** The media and navigation glyphs, drawn on a 16px grid in the text colour. Decorative: label the button. */
const paths = {
  prev: 'M10 3.5 5.5 8l4.5 4.5',
  next: 'M6 3.5 10.5 8 6 12.5',
  play: 'M5 3.2v9.6L12.6 8z',
  pause: 'M5.25 3.5v9M10.75 3.5v9',
  replay: 'M3.2 8a4.8 4.8 0 1 0 1.4-3.4M4.2 2.4v2.8H7',
  expand: 'M2.75 6V2.75H6M10 2.75h3.25V6M13.25 10v3.25H10M6 13.25H2.75V10',
  collapse: 'M6 2.75V6H2.75M13.25 6H10V2.75M10 13.25V10h3.25M2.75 10H6v3.25',
} as const

/** Solid shapes; the rest are strokes. */
const filled = new Set<IconName>(['play'])

export type IconName = keyof typeof paths

type Props = Omit<HTMLAttributes<'svg'>, 'name'> & {
  name: IconName
  /** Width and height, in pixels. */
  size?: number
}

const { name, size = 16, class: className, ...rest } = Astro.props
const solid = filled.has(name)
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 16 16"
  width={size}
  height={size}
  fill={solid ? 'currentColor' : 'none'}
  stroke={solid ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...rest}
>
  <path d={paths[name]}></path>
</svg>
