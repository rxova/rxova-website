---
/**
 * A row of captioned screenshots with an optional link beneath. Images go through Astro's `<Image>`
 * for width, height and a srcset; each sits in a card frame, since a dark screenshot is not a themed surface.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

export interface Shot {
  src: ImageMetadata
  alt: string
  title: string
  body: string
}

interface Props {
  shots: readonly Shot[]
  link?: { href: string; text: string; external?: boolean }
}

const { shots, link } = Astro.props
---

<div class="rx-shots">
  <ul class="rx-shots__grid">
    {shots.map((shot) => (
      <li class="rx-shots__item">
        <div class="rx-shots__shot">
          <Image src={shot.src} alt={shot.alt} loading="lazy" />
        </div>
        <h3 class="rx-shots__title">{shot.title}</h3>
        <p class="rx-shots__body">{shot.body}</p>
      </li>
    ))}
  </ul>

  {link && (
    <a class="rx-shots__link" href={link.href} rel={link.external ? 'noopener' : undefined}>
      {link.text}
      {link.external && (
        <svg
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
        </svg>
      )}
    </a>
  )}
</div>

<style>
  .rx-shots__grid {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }

  @media (min-width: 60rem) {
    .rx-shots__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .rx-shots__item {
    min-width: 0;
  }

  /* The frame owns the radius: on the <img> alone the card's top corners stay square behind it. */
  .rx-shots__shot {
    overflow: hidden;
    background: var(--rx-card);
    border: 1px solid var(--rx-rule);
    border-radius: var(--rx-radius);
  }

  .rx-shots__shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .rx-shots__title {
    margin: 1rem 0 0;
    color: var(--rx-fg);
    font-size: 1rem;
    font-weight: 620;
    letter-spacing: -0.01em;
  }

  .rx-shots__body {
    margin: 0.4rem 0 0;
    color: var(--rx-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .rx-shots__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.75rem;
    color: var(--rx-primary);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .rx-shots__link:hover {
    text-decoration: underline;
  }
</style>
