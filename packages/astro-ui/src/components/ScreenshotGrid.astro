---
/**
 * Screenshots shown rather than described: each in a hairline frame through Astro's `<Image>`,
 * a mono label and a line of detail under it, and an optional link beneath the row.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

export interface Shot {
  src: ImageMetadata
  alt: string
  title: string
  body: string
}

interface Props {
  shots: readonly Shot[]
  link?: { href: string; text: string; external?: boolean }
}

const { shots, link } = Astro.props
---

<div class="rx-shots">
  <ul class="rx-shots__grid">
    {shots.map((shot, index) => (
      <li class="rx-shots__item">
        <figure class="rx-shots__figure">
          <div class="rx-shots__frame">
            <Image src={shot.src} alt={shot.alt} loading="lazy" />
          </div>
          <figcaption class="rx-shots__caption">
            <span class="rx-shots__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="rx-shots__title">{shot.title}</span>
            <span class="rx-shots__body">{shot.body}</span>
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>

  {link && (
    <a class="rx-shots__link" href={link.href} rel={link.external ? 'noopener' : undefined}>
      {link.text}
      <svg
        viewBox="0 0 16 16"
        width="14"
        height="14"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        {link.external ? <path d="M5 3h8v8M13 3 3 13" /> : <path d="M3 8h10M9 4l4 4-4 4" />}
      </svg>
    </a>
  )}
</div>

<style>
  .rx-shots__grid {
    display: grid;
    gap: 2rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }

  /* Viewport breakpoints, like ValueGrid: three across on a wide screen, two on a tablet, one on a phone. */
  @media (min-width: 38rem) {
    .rx-shots__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 60rem) {
    .rx-shots__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .rx-shots__item {
    min-width: 0;
  }

  .rx-shots__figure {
    margin: 0;
  }

  /* A hairline, not a card: the screenshot is the surface. The frame owns the radius. */
  .rx-shots__frame {
    overflow: hidden;
    border: 1px solid var(--rx-rule);
    border-radius: var(--rx-radius-sm);
    background: var(--rx-card);
  }

  .rx-shots__frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* A light capture is the brightest thing on a dark page; dimmed, it sits on the surface instead of glaring. */
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .rx-shots__frame :global(img) {
      filter: brightness(0.8);
    }
  }

  :global(html[data-theme='dark']) .rx-shots__frame :global(img) {
    filter: brightness(0.8);
  }

  /* Index beside the label, detail hanging under the label; the indent binds the pair. */
  .rx-shots__caption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.7rem;
    row-gap: 0.3rem;
    margin-top: 0.9rem;
    align-content: start;
  }

  .rx-shots__index,
  .rx-shots__title {
    grid-row: 1;
    font-family: var(--rx-font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .rx-shots__index {
    grid-column: 1;
    color: var(--rx-faint);
  }

  .rx-shots__title {
    grid-column: 2;
    color: var(--rx-fg);
  }

  .rx-shots__body {
    grid-column: 2;
    grid-row: 2;
    color: var(--rx-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .rx-shots__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.75rem;
    color: var(--rx-fg);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid var(--rx-rule-strong);
    padding-bottom: 0.15rem;
  }

  .rx-shots__link:hover {
    color: var(--rx-primary);
    border-color: currentColor;
  }
</style>
