---
/**
 * An icon button that puts `text` on the clipboard and shows a tick for a moment. Drawn in
 * `currentColor`, so it sits on any surface, a dark terminal included; the caller places it.
 */
import Check from './icons/Check.astro'
import Copy from './icons/Copy.astro'

interface Props {
  /** What goes on the clipboard. */
  text: string
  /** The accessible name and tooltip; there is no visible text, so this is what a screen reader says. */
  label?: string
}

const { text, label = 'Copy' } = Astro.props
---

<button class="rx-copy" type="button" data-rx-copy={text} aria-label={label} title={label}>
  <Copy class="rx-copy__idle" />
  <Check class="rx-copy__done" />
  <span class="rx-copy__status" role="status"></span>
</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-rx-copy]')) {
    if (button.dataset.rxCopyBound) continue
    button.dataset.rxCopyBound = ''
    const status = button.querySelector<HTMLElement>('.rx-copy__status')
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.rxCopy ?? '')
      } catch {
        // Clipboard access can be denied; saying nothing beats claiming a copy that did not happen.
        return
      }
      button.dataset.state = 'done'
      if (status) status.textContent = 'Copied'
      window.setTimeout(() => {
        delete button.dataset.state
        if (status) status.textContent = ''
      }, 1600)
    })
  }
</script>

<style>
  /* One glyph over the other, so the button keeps its size when the state flips. */
  .rx-copy {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: inherit;
    background: transparent;
    border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    border-radius: var(--rx-radius-sm);
    opacity: 0.85;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      opacity 0.15s ease;
  }

  .rx-copy:hover {
    opacity: 1;
    border-color: color-mix(in srgb, currentColor 65%, transparent);
  }

  .rx-copy:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .rx-copy :global(.rx-copy__idle),
  .rx-copy :global(.rx-copy__done) {
    grid-area: 1 / 1;
  }

  .rx-copy :global(.rx-copy__done),
  .rx-copy[data-state='done'] :global(.rx-copy__idle) {
    visibility: hidden;
  }

  .rx-copy[data-state='done'] :global(.rx-copy__done) {
    visibility: visible;
  }

  /* Announced to screen readers, never shown: the tick is the visible cue. */
  .rx-copy__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .rx-copy {
      transition: none;
    }
  }
</style>
