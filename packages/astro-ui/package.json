{
  "name": "@rxova/astro-ui",
  "version": "0.7.0",
  "type": "module",
  "description": "Astro components, Starlight preset and shared chrome for rxova.dev",
  "keywords": [
    "rxova",
    "astro",
    "starlight",
    "components"
  ],
  "license": "MIT",
  "author": "Jonatan Kruszewski <jonakrusze@gmail.com>",
  "homepage": "https://rxova.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/rxova-website.git",
    "directory": "packages/astro-ui"
  },
  "bugs": "https://github.com/rxova/rxova-website/issues",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src"
  ],
  "exports": {
    "./components/*": "./src/components/*",
    "./lib/entries": "./src/lib/entries.ts",
    "./scripts/show-more": "./src/scripts/show-more.ts",
    "./starlight": "./src/starlight/index.ts",
    "./starlight/*": "./src/starlight/*",
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.36.0",
    "astro": ">=5.6.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/starlight": {
      "optional": true
    }
  },
  "scripts": {
    "check:astro": "astro check",
    "check:exports": "publint --strict",
    "pack:smoke": "rxova-repo-config pack-smoke",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@rxova/brand": "workspace:^",
    "lucide-static": "^1.61.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/starlight": "^0.42.6",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "astro": "^7.4.2",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "repoConfig": {
    "packSmoke": {
      "load": "never"
    }
  }
}
