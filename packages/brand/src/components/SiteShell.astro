---
/**
 * Artifact document for rxova.org's non-Starlight page components.
 *
 * It lived in both packages as a 244-line file that differed on four lines, which
 * is exactly how the menu came to render in a different order on each: a fix has to
 * be made twice, and once was enough to forget.
 *
 * This deliberately owns no site header, footer, analytics or theme bootstrap.
 * It gives an independently-built page component a standards-compliant document
 * for its metadata and assets; rxova-website consumes its body and supplies the
 * public shell at deploy time.
 */
import '../fonts.css'
import '../astro.css'

import { canonicalUrl, siteUrl } from '../sites.ts'

interface Props {
  title: string
  description: string
  /** Canonical path, e.g. `/blog/why-rxova-has-a-blog`. Normalised below. */
  path: string
  ogType?: 'website' | 'article'
  /**
   * Absolute URL of the social card. Defaults to the umbrella card.
   *
   * A prop rather than something derived here, because what makes the best card
   * differs per surface and only the caller knows: a post with a cover should
   * share its cover, an update belongs to a project and should carry that
   * project's card, and an index has neither.
   */
  image?: string
  /** Advertises an RSS feed for this surface, as `rel="alternate"`. */
  feed?: { href: string; title: string }
  /**
   * JSON-LD for this page, emitted verbatim as `application/ld+json`.
   *
   * Structured data is the only way a crawler learns that /blog carries articles
   * with an author and a date rather than prose it has to infer that from. Typed
   * as unknown because the shapes differ per surface and schema.org is not worth
   * modelling in TypeScript for three call sites.
   */
  jsonLd?: unknown
}

const { title, description, path, ogType = 'website', image, feed, jsonLd } = Astro.props

// Normalised here rather than at the four call sites: every one of them had
// dropped the trailing slash, so every blog and updates page was declaring itself
// canonical at a URL that 301s. A caller can forget again; this cannot.
const canonical = canonicalUrl(path)

const ogImage = image ?? siteUrl('/og/rxova.png')

/**
 * Serialise JSON-LD for an inline `<script>`.
 *
 * `<` is escaped because a `</script>` anywhere inside a string value — a post
 * title about a tag, a description quoting markup — closes the element early and
 * spills the rest of the payload into the document as text. `<` is valid
 * JSON and parses back to `<`, so the structured data is unchanged.
 */
const serialiseJsonLd = (value: unknown): string => JSON.stringify(value).replace(/</g, '\\u003c')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {feed && (
      <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />
    )}
    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={serialiseJsonLd(jsonLd)}></script>
    )}
  </head>
  <body>
    <main>
      <slot />
    </main>

    <style>
      main {
        max-width: var(--max);
        margin: 0 auto;
        padding: clamp(2rem, 6vh, 3.5rem) 1.5rem 4rem;
      }
    </style>

    <!-- Prose styling for rendered markdown. Global rather than scoped: the
         markup comes from <Content /> at build time, so it carries none of
         Astro's scoping attributes. Kept here so both /blog and /updates read
         the same. -->
    <style is:global>
      .prose {
        color: var(--muted);
        line-height: 1.7;
      }
      .prose > * + * {
        margin-top: 1.1rem;
      }
      .prose h2 {
        color: var(--fg);
        font-size: 1.25rem;
        font-weight: 640;
        letter-spacing: -0.01em;
        margin-top: 2.5rem;
      }
      .prose h3 {
        color: var(--fg);
        font-size: 1.05rem;
        font-weight: 620;
        margin-top: 2rem;
      }
      .prose a {
        color: var(--fg);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .prose strong {
        color: var(--fg);
        font-weight: 620;
      }
      .prose ul,
      .prose ol {
        margin-left: 1.2rem;
      }
      .prose li + li {
        margin-top: 0.35rem;
      }
      .prose code {
        font-family: var(--mono);
        font-size: 0.88em;
        background: var(--tag-bg);
        padding: 0.05rem 0.35rem;
        border-radius: 4px;
      }
      .prose pre {
        background: var(--card);
        border: 1px solid var(--rule);
        border-radius: 10px;
        padding: 1rem 1.1rem;
        /* Long lines scroll inside the block; the page itself never does. */
        overflow-x: auto;
      }
      .prose pre code {
        background: none;
        padding: 0;
      }
      .prose blockquote {
        border-left: 2px solid var(--rule);
        padding-left: 1rem;
        color: var(--faint);
      }
      .prose img {
        max-width: 100%;
        height: auto;
        border-radius: 10px;
      }
      .prose table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
      }
      .prose th,
      .prose td {
        border-bottom: 1px solid var(--rule);
        padding: 0.5rem 0.6rem;
        text-align: left;
      }
      .prose th {
        color: var(--fg);
        font-weight: 620;
      }
    </style>
  </body>
</html>
