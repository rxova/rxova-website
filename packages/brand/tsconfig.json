{
  "extends": "@rxova/repo-tooling/tsconfig.base.json",
  "compilerOptions": {
    // Shipped as source, so imports keep their `.ts` extension and resolve the way bundlers do.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "*.config.ts"]
}
