{
  "extends": "@rxova/repo-config/tsconfig.base.json",
  "compilerOptions": {
    // Shipped as source, so imports keep their `.ts` extension and resolve the way bundlers do.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "*.config.ts"]
}
