{
  "name": "@rxova/brand",
  "version": "1.0.0",
  "type": "module",
  "description": "Design tokens, typefaces and project data for rxova.org",
  "keywords": [
    "rxova",
    "design-tokens",
    "theme"
  ],
  "license": "MIT",
  "author": "Jonatan Kruszewski <jonakrusze@gmail.com>",
  "homepage": "https://rxova.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/rxova-website.git",
    "directory": "packages/brand"
  },
  "bugs": "https://github.com/rxova/rxova-website/issues",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "assets"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pack:smoke": "node --import tsx scripts/pack-smoke.ts",
    "check:exports": "publint --strict",
    "og": "node --import tsx scripts/generate-og.ts",
    "check:og": "node --import tsx scripts/generate-og.ts --check",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/space-grotesk": "^5.2.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@rxova/repo-tooling": "workspace:*",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "astro": "^7.3.2",
    "publint": "^0.3.24",
    "satori": "^0.33.4",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
