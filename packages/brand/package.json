{
  "name": "@rxova/brand",
  "version": "1.4.0",
  "type": "module",
  "description": "Design tokens, typefaces and project data for rxova.dev",
  "keywords": [
    "rxova",
    "design-tokens",
    "theme"
  ],
  "license": "MIT",
  "author": "Jonatan Kruszewski <jonakrusze@gmail.com>",
  "homepage": "https://rxova.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/rxova-website.git",
    "directory": "packages/brand"
  },
  "bugs": "https://github.com/rxova/rxova-website/issues",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "assets",
    "MIGRATION.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pack:smoke": "rxova-repo-config pack-smoke",
    "check:exports": "publint --strict",
    "og": "node --import tsx scripts/generate-og.ts",
    "check:og": "node --import tsx scripts/generate-og.ts --check",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "publint": "^0.3.25",
    "satori": "^0.36.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "repoConfig": {
    "packSmoke": {
      "load": "never"
    }
  }
}
