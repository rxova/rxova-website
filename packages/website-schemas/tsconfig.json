{
  // Standalone, not extending `astro/tsconfigs/strict`: nothing here touches Astro, and the
  // schema is plain zod so a plain Node validator can import it.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    // Ships uncompiled source like @rxova/brand does — the website imports it
    // straight out of a checkout, so nothing here ever emits.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
