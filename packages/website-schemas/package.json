{
  "name": "@rxova/website-schemas",
  "version": "0.6.2",
  "type": "module",
  "description": "The contracts between rxova repos: for the website",
  "keywords": [
    "rxova",
    "schema",
    "zod",
    "content",
    "frontmatter"
  ],
  "license": "MIT",
  "author": "Jonatan Kruszewski <jonakrusze@gmail.com>",
  "homepage": "https://rxova.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/rxova-website.git",
    "directory": "packages/website-schemas"
  },
  "bugs": "https://github.com/rxova/rxova-website/issues",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check:exports": "publint --strict",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "sideEffects": false
}
