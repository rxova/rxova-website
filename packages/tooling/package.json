{
  "name": "@rxova/repo-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Repo tooling for rxova-website: the behaviour lock, and later the deploy and repo scripts.",
  "type": "module",
  "exports": {
    "./playwright": "./config/playwright.ts",
    "./vitest": "./config/vitest.ts",
    "./tsconfig.base.json": "./config/tsconfig.base.json"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "serve:site": "node src/e2e/serve.ts"
  },
  "dependencies": {
    "@rxova/website-schemas": "workspace:^",
    "parse5": "^8.0.1",
    "prettier": "^3.9.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
